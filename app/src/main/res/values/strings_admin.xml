    <string name="admin_token_forget">Forget the token</string>
    <string name="admin_token_forget_confirm">The panel stops working for this account until a new token is set. The token itself stays valid on the server: revoke it there if it is no longer needed.</string>
    <string name="admin_token_forget_action">Forget</string>
    <string name="admin_safety_card">Safety</string>
    <string name="admin_read_only">Read-only</string>
    <string name="admin_read_only_desc">Only look: no rename, delete or new keys. Every change also asks for the screen lock.</string>
    <string name="admin_read_only_no_lock">This phone has no screen lock, so the panel only reads: nothing could prove who asks for a change. Set a PIN, pattern or password to make changes.</string>
    <string name="admin_device_card">This device\'s sign-in (experimental)</string>
    <string name="admin_device_desc">Instead of a token, sign in with the account this device uses, in the browser. The answer is kept in memory only and lapses within hours. Whether the server accepts it depends on its sign-in setup; if it does not, the stored token is used.</string>
    <string name="admin_device_button">Use this device\'s sign-in</string>
    <string name="admin_device_stop">Stop using this device\'s sign-in</string>
    <string name="admin_setup_reason_rejected">The server rejected the stored token: it expired, was revoked or belongs to another account.</string>
