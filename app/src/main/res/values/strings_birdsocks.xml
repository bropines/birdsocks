    <string name="nb_settings_device_name">Device name</string>
    <string name="nb_settings_device_name_desc">How this device appears among the peers. NetBird takes it when the device registers; a renamed device keeps its old DNS name until it registers again.</string>
    <string name="nb_settings_server">Management server</string>
    <string name="nb_settings_logout">Log out</string>
    <string name="nb_settings_logout_desc">Remove this device from the network</string>
    <string name="nb_settings_logout_confirm">The device is removed from the network and forgets its keys. Signing in again registers it as a new peer.</string>
    <string name="nb_settings_socks_port">Port</string>
    <string name="nb_settings_bad_port">A port is a number from 1 to 65535</string>
    <string name="nb_settings_socks_user">Username</string>
    <string name="nb_settings_socks_pass">Password</string>
    <string name="nb_settings_socks_auth_desc">Any app on this phone can find a proxy on localhost. With a username and a password only the apps you give them to can use it. Set both or neither.</string>
    <string name="nb_settings_socks_lan">Share on the local network</string>
    <string name="nb_settings_socks_lan_desc">Listen on every interface, so other devices on the Wi-Fi can use the proxy. Set a password first.</string>
    <string name="nb_settings_dns_proxy">DNS proxy</string>
    <string name="nb_settings_dns_proxy_desc">Answers plain DNS on this address: NetBird names first, everything else through the network\'s resolvers. Point AdGuard or another app\'s DNS here.</string>
    <string name="nb_settings_dns_proxy_address">Address</string>
    <string name="nb_settings_bad_address">An address is host:port, such as 127.0.0.1:48153</string>
    <string name="nb_settings_netbird">NetBird</string>
    <string name="nb_settings_netbird_off">Start BirdSocks to change these: they live in NetBird\'s profile.</string>
    <string name="nb_settings_rosenpass_desc">Post-quantum keys on top of WireGuard. Both peers need it on.</string>
    <string name="nb_settings_rosenpass_permissive">Rosenpass permissive</string>
    <string name="nb_settings_rosenpass_permissive_desc">Still connect to peers that have no Rosenpass.</string>
    <string name="nb_settings_lazy">Lazy connections</string>
    <string name="nb_settings_lazy_desc">Connect to a peer only when traffic goes to it. Saves battery with many peers; the first packet waits a moment.</string>
    <string name="nb_settings_block_inbound">Block inbound</string>
    <string name="nb_settings_block_inbound_desc">Refuse connections other peers open to this device, whatever the access policies allow.</string>
    <string name="nb_settings_dns">NetBird DNS</string>
    <string name="nb_settings_dns_desc">Resolve peer names and the network\'s DNS zones through the proxy.</string>
    <string name="nb_settings_client_routes">Use networks</string>
    <string name="nb_settings_client_routes_desc">Reach the networks and exit nodes other peers route for.</string>
    <string name="nb_settings_ipv6">IPv6 overlay</string>
    <string name="nb_settings_ipv6_desc">Take an IPv6 address in the network when the server hands one out.</string>
    <string name="nb_settings_daemon">The daemon</string>
    <string name="nb_settings_force_relay">Always through a relay</string>
    <string name="nb_settings_force_relay_desc">Never connect peers directly. For networks that break peer-to-peer connections; slower.</string>
    <string name="nb_settings_log_level">Log detail</string>
    <string name="nb_settings_env">Environment</string>
    <string name="nb_settings_env_desc">NAME=value pairs for the daemon, comma-separated: NB_RELAY_TRANSPORT=ws, NB_ICE_* and the like. For debugging.</string>
    <string name="nb_settings_background">Background</string>
    <string name="nb_settings_boot">Start on boot</string>
    <string name="nb_settings_boot_desc">Come back after a reboot if BirdSocks was running.</string>
    <string name="nb_settings_permissions">Permissions</string>
    <string name="nb_settings_permissions_desc">Battery optimisation, notifications, autostart</string>
    <string name="nb_settings_about">About</string>
    <string name="nb_settings_daemon_version">Daemon %1$s</string>
    <string name="nb_settings_about_desc">BirdSocks runs the NetBird client as a userspace node and hands its network to apps through a SOCKS5 proxy, without taking the VPN slot. Not affiliated with NetBird GmbH.</string>
