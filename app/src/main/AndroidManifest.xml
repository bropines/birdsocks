            <intent-filter>
                <action android:name="io.github.bropines.birdsocks.action.CONNECT" />
                <action android:name="io.github.bropines.birdsocks.action.DISCONNECT" />
                <action android:name="io.github.bropines.birdsocks.action.TOGGLE" />
                <action android:name="io.github.bropines.birdsocks.action.RESTART" />
                <action android:name="io.github.bropines.birdsocks.action.GET_STATUS" />
                <action android:name="io.github.bropines.birdsocks.action.SET_EXIT_NODE" />
                <action android:name="io.github.bropines.birdsocks.action.SWITCH_ACCOUNT" />
                <action android:name="io.github.bropines.birdsocks.action.SET_TUN" />
                <action android:name="io.github.bropines.birdsocks.action.SET_SERVER_CONNECTION" />
            </intent-filter>
        </receiver>

        <receiver android:name=".core.BootReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The updater hands its verified APK to the installer through this (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
