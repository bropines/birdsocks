        <service android:name=".core.NetbirdService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="netbird mesh network node and its local SOCKS5 proxy" />
        </service>

        <!-- VPN mode (core/TunVpnService.kt): hev-socks5-tunnel into the SOCKS5 proxy. Not
             started foreground: the system binds a VPN service at foreground priority itself. -->
        <service android:name=".core.TunVpnService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
