+package forwarder
+
+// birdsocks_vpn.go — BirdSocks: a forwarder for the app's VPN. What apps on
+// the phone send through Android's VPN to a destination no peer carries (the
+// local network behind an exit node, the internet under a domain route, the
+// VPN's own resolver) is terminated in this stack and dialed again from the
+// daemon, whose UID the VPN leaves out; the answers go back into the VPN
+// interface instead of to a peer.
+
+import (
+	"context"
+	"net"
+	"os"
+	"sync"
+
+	log "github.com/sirupsen/logrus"
+
+	nblog "github.com/netbirdio/netbird/client/firewall/uspfilter/log"
+	"github.com/netbirdio/netbird/client/iface/wgaddr"
+	nftypes "github.com/netbirdio/netbird/client/internal/netflow/types"
+)
+
+// OutboundWriter takes the packets the forwarder sends back toward the
+// source of a connection: a peer through the WireGuard device, or an app
+// through the VPN interface. dst is the packet's destination address.
+type OutboundWriter interface {
+	CreateOutboundPacket(packet []byte, dst net.IP) error
+}
+
+// DialFunc reaches the destination of a forwarded connection.
+type DialFunc func(ctx context.Context, network, address string) (net.Conn, error)
+
+var directLogger = sync.OnceValue(func() *nblog.Logger { return nblog.NewFromLogrus(log.StandardLogger()) })
+
+// NewDirect is a forwarder whose answers go to out and whose connections
+// are dialed with dial. addr is the address apps send from; every other
+// destination is accepted too (the stack is promiscuous and spoofs).
+func NewDirect(addr wgaddr.Address, out OutboundWriter, dial DialFunc, mtu uint16) (*Forwarder, error) {
+	f, err := newForwarder(addr, out, directLogger(), noFlowLogger{}, false, mtu)
+	if err != nil {
+		return nil, err
+	}
+	if dial != nil {
+		f.dial = dial
+	}
+	return f, nil
+}
+
+// noFlowLogger: the apps' own traffic is not NetBird network traffic, and
+// the flow log is for that.
+type noFlowLogger struct{}
+
+func (noFlowLogger) ResetAggregationWindow() nftypes.FlowEventAggregator { return nil }
+func (noFlowLogger) StoreEvent(nftypes.EventFields)                      {}
+func (noFlowLogger) Close()                                              {}
+func (noFlowLogger) Enable()                                             {}
+func (noFlowLogger) UpdateConfig(bool, bool)                             {}
+
+// androidPing is where Android keeps ping.
+const androidPing = "/system/bin/ping"
+
+// linuxPingBin names ping by its path when it is Android's: searching PATH
+// makes os/exec call faccessat2, which an app's seccomp filter answers with
+// SIGSYS, and the daemon dies.
+var linuxPingBin = sync.OnceValue(func() string {
+	if st, err := os.Stat(androidPing); err == nil && !st.IsDir() {
+		return androidPing
+	}
+	return pingBin
+})
