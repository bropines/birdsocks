--- netbird_orig/client/internal/dns/birdsocks.go
+++ netbird_src/client/internal/dns/birdsocks.go
@@ -0,0 +1,22 @@
+package dns
+
+// birdsocks.go — BirdSocks: the domains NetBird resolves itself or sends to
+// the account's nameservers, for the app's DNS proxies, which must never ask
+// a public resolver about them (iface/netstack/searchdomains.go).
+
+import "strings"
+
+// OwnDomains lists every domain of the current DNS configuration — the
+// peers' zone, custom zones, nameserver groups' match domains — whether or
+// not it is a search domain or currently disabled.
+func (s *DefaultServer) OwnDomains() []string {
+	s.mux.Lock()
+	defer s.mux.Unlock()
+	out := make([]string, 0, len(s.currentConfig.Domains))
+	for _, d := range s.currentConfig.Domains {
+		if name := strings.TrimSuffix(d.Domain, "."); name != "" {
+			out = append(out, name)
+		}
+	}
+	return out
+}
