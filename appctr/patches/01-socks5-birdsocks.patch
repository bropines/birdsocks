+package netstack
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// fakeDial: "hang" never connects until ctx ends, "fail" fails at once,
+// anything else connects over a pipe.
+func fakeDial(t *testing.T, closed *atomic.Int32) func(ctx context.Context, network, addr string) (net.Conn, error) {
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		host, _, _ := net.SplitHostPort(addr)
+		switch host {
+		case "192.0.2.1": // hangs
+			<-ctx.Done()
+			return nil, ctx.Err()
+		case "192.0.2.2": // refused
+			return nil, errors.New("refused")
+		}
+		a, b := net.Pipe()
+		go func() { <-ctx.Done(); _ = b.Close() }()
+		return &countingConn{Conn: a, closed: closed}, nil
+	}
+}
+
+type countingConn struct {
+	net.Conn
+	closed *atomic.Int32
+}
+
+func (c *countingConn) Close() error { c.closed.Add(1); return c.Conn.Close() }
+
+func withFake(t *testing.T) *atomic.Int32 {
+	var closed atomic.Int32
+	old := dialFunc
+	dialFunc = fakeDial(t, &closed)
+	t.Cleanup(func() { dialFunc = old })
+	return &closed
+}
+
+func TestHangingFirstAddressFallsBack(t *testing.T) {
+	withFake(t)
+	start := time.Now()
+	c, err := dialStaggered(context.Background(), "tcp", []string{"192.0.2.1:443", "192.0.2.3:443"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if took := time.Since(start); took < fallbackDelay || took > fallbackDelay+time.Second {
+		t.Fatalf("connected after %v, want about %v", took, fallbackDelay)
+	}
+}
+
+func TestRefusedFirstAddressFallsBackAtOnce(t *testing.T) {
+	withFake(t)
+	start := time.Now()
+	c, err := dialStaggered(context.Background(), "tcp", []string{"192.0.2.2:443", "192.0.2.3:443"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if took := time.Since(start); took > 500*time.Millisecond {
+		t.Fatalf("connected after %v; a refusal should move on at once", took)
+	}
+}
+
+func TestAllFail(t *testing.T) {
+	withFake(t)
+	_, err := dialStaggered(context.Background(), "tcp", []string{"192.0.2.2:443", "192.0.2.2:80"})
+	if err == nil {
+		t.Fatal("connected to nothing")
+	}
+}
+
+func TestDirectDialUsesRememberedAddresses(t *testing.T) {
+	withFake(t)
+	alternatives.put(net.ParseIP("192.0.2.1"), []net.IP{net.ParseIP("192.0.2.1"), net.ParseIP("192.0.2.3")})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	c, err := dialDirect(ctx, "tcp", "192.0.2.1:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+	// Unknown addresses dial once, as before.
+	ctx2, cancel2 := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel2()
+	if _, err := dialDirect(ctx2, "tcp", "192.0.2.9:443"); err != nil {
+		t.Fatalf("plain dial: %v", err)
+	}
+}
+
+func TestAltOrderPrefersChosenFamily(t *testing.T) {
+	c := &altCache{entries: map[string]altEntry{}}
+	v6 := net.ParseIP("2001:db8::1")
+	a, b := net.ParseIP("198.51.100.1"), net.ParseIP("198.51.100.2")
+	c.put(b, []net.IP{v6, a, b})
+	got := c.get("198.51.100.2")
+	if len(got) != 3 || !got[0].Equal(b) || !got[1].Equal(a) || !got[2].Equal(v6) {
+		t.Fatalf("order %v", got)
+	}
+}
