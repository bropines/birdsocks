+package netstack
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestExpansions(t *testing.T) {
+	SetSearchDomains(func() []string { return []string{"corp.example.", "example.com"} })
+	defer SetSearchDomains(nil)
+	if got := expansions("sleeperpc."); !reflect.DeepEqual(got, []string{"sleeperpc.corp.example", "sleeperpc.example.com"}) {
+		t.Errorf("short name: %v", got)
+	}
+	if got := expansions("argocd-internal"); len(got) != 2 {
+		t.Errorf("short name without the root dot: %v", got)
+	}
+	if got := expansions("ams.corp.example."); got != nil {
+		t.Errorf("a dotted name must not be expanded: %v", got)
+	}
+	SetSearchDomains(nil)
+	if got := expansions("sleeperpc"); got != nil {
+		t.Errorf("no domains: %v", got)
+	}
+}
--- netbird_orig/client/iface/netstack/fallback.go
+++ netbird_src/client/iface/netstack/fallback.go
@@ -0,0 +1,150 @@
+package netstack
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+)
+
+// fallbackDelay is how long a direct dial waits on one address before it
+// tries the name's next one alongside: a CDN's addresses are blocked one by
+// one on some networks, and a browser moves on instead of hanging.
+const fallbackDelay = 750 * time.Millisecond
+
+// alternatives remembers, for a minute, every address of the names the
+// proxy resolved, keyed by the one it handed out, so the direct dial can
+// fall back to the others.
+var alternatives = &altCache{entries: map[string]altEntry{}}
+
+type altEntry struct {
+	addrs []net.IP
+	until time.Time
+}
+
+type altCache struct {
+	mu      sync.Mutex
+	entries map[string]altEntry
+}
+
+const altCacheMax = 1024
+
+// put records all of a name's addresses under chosen, chosen first.
+func (c *altCache) put(chosen net.IP, all []net.IP) {
+	if len(all) < 2 {
+		return
+	}
+	ordered := []net.IP{chosen}
+	for _, v4 := range []bool{chosen.To4() != nil, chosen.To4() == nil} {
+		for _, ip := range all {
+			if !ip.Equal(chosen) && (ip.To4() != nil) == v4 {
+				ordered = append(ordered, ip)
+			}
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) >= altCacheMax {
+		c.entries = map[string]altEntry{}
+	}
+	c.entries[chosen.String()] = altEntry{addrs: ordered, until: time.Now().Add(time.Minute)}
+}
+
+// get returns the addresses to try for host, the given one first.
+func (c *altCache) get(host string) []net.IP {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e, ok := c.entries[host]
+	if !ok || time.Now().After(e.until) {
+		return nil
+	}
+	return e.addrs
+}
+
+// dialFunc is the plain dial a fallback dial is made of; tests replace it.
+var dialFunc = func(ctx context.Context, network, addr string) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, network, addr)
+}
+
+// dialDirect dials addr over the host's network; for TCP to an address the
+// proxy resolved from a name, the name's other addresses follow, staggered.
+func dialDirect(ctx context.Context, network, addr string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || (network != "tcp" && network != "tcp4" && network != "tcp6") {
+		return dialFunc(ctx, network, addr)
+	}
+	alts := alternatives.get(host)
+	if len(alts) < 2 {
+		return dialFunc(ctx, network, addr)
+	}
+	addrs := make([]string, 0, len(alts))
+	for _, ip := range alts {
+		addrs = append(addrs, net.JoinHostPort(ip.String(), port))
+	}
+	return dialStaggered(ctx, network, addrs)
+}
+
+// dialStaggered dials addrs[0], starts the next address when the last one
+// failed or has not connected within fallbackDelay, and returns the first
+// connection made; the losers are closed.
+func dialStaggered(ctx context.Context, network string, addrs []string) (net.Conn, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	type result struct {
+		conn net.Conn
+		err  error
+	}
+	results := make(chan result, len(addrs))
+	dial := dialFunc
+	pending, next := 0, 0
+	start := func() {
+		a := addrs[next]
+		next++
+		pending++
+		go func() {
+			c, err := dial(ctx, network, a)
+			results <- result{c, err}
+		}()
+	}
+	// The dials still running when one wins are drained and closed.
+	drain := func(n int) {
+		go func() {
+			for i := 0; i < n; i++ {
+				if r := <-results; r.conn != nil {
+					_ = r.conn.Close()
+				}
+			}
+		}()
+	}
+	start()
+	timer := time.NewTimer(fallbackDelay)
+	defer timer.Stop()
+	var firstErr error
+	for pending > 0 {
+		select {
+		case r := <-results:
+			pending--
+			if r.err == nil {
+				drain(pending)
+				return r.conn, nil
+			}
+			if firstErr == nil {
+				firstErr = r.err
+			}
+			if next < len(addrs) {
+				start()
+				timer.Reset(fallbackDelay)
+			}
+		case <-timer.C:
+			if next < len(addrs) {
+				start()
+				timer.Reset(fallbackDelay)
+			}
+		case <-ctx.Done():
+			drain(pending)
+			return nil, ctx.Err()
+		}
+	}
+	return nil, firstErr
+}
