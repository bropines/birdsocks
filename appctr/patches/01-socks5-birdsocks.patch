+package netstack
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"net/netip"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/things-go/go-socks5"
+	"github.com/things-go/go-socks5/statute"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+const testTunDNS = "198.18.0.2"
+
+func dnsQuery(t *testing.T, id uint16, name string) []byte {
+	t.Helper()
+	msg := dnsmessage.Message{
+		Header:    dnsmessage.Header{ID: id, RecursionDesired: true},
+		Questions: []dnsmessage.Question{{Name: dnsmessage.MustNewName(name), Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET}},
+	}
+	b, err := msg.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+// answerA is a positive answer to q: name → ip.
+func answerA(q []byte, ip [4]byte) []byte {
+	var msg dnsmessage.Message
+	if err := msg.Unpack(q); err != nil {
+		return nil
+	}
+	msg.Response, msg.RecursionAvailable = true, true
+	msg.Answers = []dnsmessage.Resource{{
+		Header: dnsmessage.ResourceHeader{Name: msg.Questions[0].Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET, TTL: 60},
+		Body:   &dnsmessage.AResource{A: ip},
+	}}
+	b, _ := msg.Pack()
+	return b
+}
+
+func rcodeOf(t *testing.T, resp []byte) dnsmessage.RCode {
+	t.Helper()
+	var msg dnsmessage.Message
+	if err := msg.Unpack(resp); err != nil {
+		t.Fatalf("bad answer: %v", err)
+	}
+	return msg.RCode
+}
+
+func firstA(t *testing.T, resp []byte) [4]byte {
+	t.Helper()
+	var msg dnsmessage.Message
+	if err := msg.Unpack(resp); err != nil || len(msg.Answers) == 0 {
+		t.Fatalf("no answer: %v", err)
+	}
+	return msg.Answers[0].Body.(*dnsmessage.AResource).A
+}
+
+// fakeDNS is a UDP server on 127.0.0.1 that answers with reply (nil: never),
+// after delay, and counts the queries it got.
+func fakeDNS(t *testing.T, delay time.Duration, reply func(q []byte) []byte) (string, *atomic.Int32) {
+	t.Helper()
+	pc, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { pc.Close() })
+	var count atomic.Int32
+	go func() {
+		b := make([]byte, 1500)
+		for {
+			n, from, err := pc.ReadFrom(b)
+			if err != nil {
+				return
+			}
+			count.Add(1)
+			q := append([]byte(nil), b[:n]...)
+			go func() {
+				time.Sleep(delay)
+				if r := reply(q); r != nil {
+					_, _ = pc.WriteTo(r, from)
+				}
+			}()
+		}
+	}()
+	return pc.LocalAddr().String(), &count
+}
+
+func withResolve(t *testing.T, f func([]byte) []byte) {
+	t.Helper()
+	saved := tunDNSResolve
+	tunDNSResolve = f
+	t.Cleanup(func() { tunDNSResolve = saved })
+}
+
+func TestTunDNSOnlyItsAddress(t *testing.T) {
+	t.Setenv(EnvTunDNSAddress, testTunDNS)
+	if _, handled, _ := tunDNSDial("udp", "1.1.1.1:53"); handled {
+		t.Fatal("took over a dial to another address")
+	}
+	conn, handled, err := tunDNSDial("udp", testTunDNS+":53")
+	if !handled || err != nil || conn == nil {
+		t.Fatalf("port 53: handled %v, %v", handled, err)
+	}
+	conn.Close()
+	// Private DNS "automatic" probes 853: refused at once, and the SOCKS5
+	// server turns the message into "connection refused".
+	_, handled, err = tunDNSDial("tcp", testTunDNS+":853")
+	if !handled || err == nil || !strings.Contains(err.Error(), "refused") {
+		t.Fatalf("853: handled %v, err %v", handled, err)
+	}
+	t.Setenv(EnvTunDNSAddress, "")
+	if _, handled, _ := tunDNSDial("udp", testTunDNS+":53"); handled {
+		t.Fatal("intercepting with no VPN address set")
+	}
+}
+
+func TestTunDNSDatagram(t *testing.T) {
+	withResolve(t, func(q []byte) []byte { return answerA(q, [4]byte{100, 92, 1, 2}) })
+	c := newTunDNSConn(netip.MustParseAddrPort(testTunDNS+":53"), false, tunDNSResolve)
+	defer c.Close()
+	if _, err := c.Write(dnsQuery(t, 7, "peer.netbird.cloud.")); err != nil {
+		t.Fatal(err)
+	}
+	_ = c.SetReadDeadline(time.Now().Add(2 * time.Second))
+	b := make([]byte, 1500)
+	n, err := c.Read(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b[0] != 0 || b[1] != 7 || firstA(t, b[:n]) != [4]byte{100, 92, 1, 2} {
+		t.Fatalf("wrong answer %x", b[:n])
+	}
+}
+
+// Over TCP two pipelined queries, one slow, both answer; after the client's
+// half-close Read ends with EOF once they are out.
+func TestTunDNSStream(t *testing.T) {
+	withResolve(t, func(q []byte) []byte {
+		if q[1] == 1 {
+			time.Sleep(100 * time.Millisecond)
+		}
+		return answerA(q, [4]byte{10, 0, 0, q[1]})
+	})
+	c := newTunDNSConn(netip.MustParseAddrPort(testTunDNS+":53"), true, tunDNSResolve)
+	defer c.Close()
+	var framed []byte
+	for _, id := range []uint16{1, 2} {
+		q := dnsQuery(t, id, "a.example.")
+		framed = append(framed, byte(len(q)>>8), byte(len(q)))
+		framed = append(framed, q...)
+	}
+	// Written in odd pieces, as a stream may arrive.
+	for len(framed) > 0 {
+		n := min(5, len(framed))
+		if _, err := c.Write(framed[:n]); err != nil {
+			t.Fatal(err)
+		}
+		framed = framed[n:]
+	}
+	_ = c.CloseWrite()
+	_ = c.SetReadDeadline(time.Now().Add(2 * time.Second))
+	all, err := io.ReadAll(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[byte]bool{}
+	for len(all) >= 2 {
+		n := int(all[0])<<8 | int(all[1])
+		msg := all[2 : 2+n]
+		all = all[2+n:]
+		if a := firstA(t, msg); a[3] != msg[1] {
+			t.Fatalf("answer %v for id %d", a, msg[1])
+		}
+		got[msg[1]] = true
+	}
+	if !got[1] || !got[2] || len(all) != 0 {
+		t.Fatalf("answers %v, %d bytes left", got, len(all))
+	}
+}
+
+func TestTunDNSUnansweredIsServfail(t *testing.T) {
+	withResolve(t, func([]byte) []byte { return nil })
+	c := newTunDNSConn(netip.MustParseAddrPort(testTunDNS+":53"), false, tunDNSResolve)
+	defer c.Close()
+	_, _ = c.Write(dnsQuery(t, 9, "nothing.example."))
+	_ = c.SetReadDeadline(time.Now().Add(2 * time.Second))
+	b := make([]byte, 1500)
+	n, err := c.Read(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rcodeOf(t, b[:n]) != dnsmessage.RCodeServerFailure {
+		t.Fatalf("want SERVFAIL, got %x", b[:n])
+	}
+}
+
+func TestTunDNSReadDeadlineAndClose(t *testing.T) {
+	c := newTunDNSConn(netip.MustParseAddrPort(testTunDNS+":53"), false, func([]byte) []byte { return nil })
+	_ = c.SetReadDeadline(time.Now().Add(50 * time.Millisecond))
+	if _, err := c.Read(make([]byte, 10)); err == nil {
+		t.Fatal("no deadline error")
+	}
+	_ = c.SetReadDeadline(time.Time{})
+	done := make(chan error, 1)
+	go func() { _, err := c.Read(make([]byte, 10)); done <- err }()
+	time.Sleep(20 * time.Millisecond)
+	c.Close()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("read after close succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Close did not wake Read")
+	}
+}
+
+// The whole path a VPN's DNS takes: hev's UDP ASSOCIATE and TCP CONNECT
+// to the virtual address through the daemon's SOCKS5 server, answered with
+// no engine by the fallback, while a probe of 853 is refused.
+func TestTunDNSThroughSocks(t *testing.T) {
+	resetFront(t, time.Now().Add(-time.Hour)) // no engine, none expected
+	t.Setenv(EnvTunDNSAddress, testTunDNS)
+	up, _ := fakeDNS(t, 0, func(q []byte) []byte { return answerA(q, [4]byte{93, 184, 216, 34}) })
+	t.Setenv(EnvDNSProxyUpstream, up)
+
+	srv := socks5.NewServer(socks5.WithDial(frontDialer{}.Dial), socks5.WithAssociateHandle(associateHandler(frontDialer{})))
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() { _ = srv.Serve(ln) }()
+
+	greet := func() net.Conn {
+		c, err := net.Dial("tcp4", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = c.SetDeadline(time.Now().Add(8 * time.Second))
+		_, _ = c.Write([]byte{5, 1, 0})
+		if b := readN(t, c, 2); !bytes.Equal(b, []byte{5, 0}) {
+			t.Fatalf("greeting %v", b)
+		}
+		return c
+	}
+
+	// UDP.
+	ctrl := greet()
+	defer ctrl.Close()
+	_, _ = ctrl.Write([]byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0})
+	rep := readN(t, ctrl, 10)
+	if rep[1] != 0 {
+		t.Fatalf("associate refused %v", rep)
+	}
+	u, err := net.DialUDP("udp4", nil, &net.UDPAddr{IP: net.IP(rep[4:8]), Port: int(rep[8])<<8 | int(rep[9])})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer u.Close()
+	dg, _ := statute.NewDatagram(testTunDNS+":53", dnsQuery(t, 0x4242, "example.com."))
+	_, _ = u.Write(dg.Bytes())
+	_ = u.SetReadDeadline(time.Now().Add(8 * time.Second))
+	b := make([]byte, 1500)
+	n, err := u.Read(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, err := statute.ParseDatagram(b[:n])
+	if err != nil || firstA(t, back.Data) != [4]byte{93, 184, 216, 34} || back.Data[0] != 0x42 {
+		t.Fatalf("udp answer %x, %v", back.Data, err)
+	}
+
+	// TCP.
+	tc := greet()
+	defer tc.Close()
+	_, _ = tc.Write([]byte{5, 1, 0, 1, 198, 18, 0, 2, 0, 53})
+	if rep := readN(t, tc, 10); rep[1] != 0 {
+		t.Fatalf("connect refused %v", rep)
+	}
+	q := dnsQuery(t, 0x0102, "example.com.")
+	_, _ = tc.Write(append([]byte{byte(len(q) >> 8), byte(len(q))}, q...))
+	l := readN(t, tc, 2)
+	resp := readN(t, tc, int(l[0])<<8|int(l[1]))
+	if firstA(t, resp) != [4]byte{93, 184, 216, 34} {
+		t.Fatalf("tcp answer %x", resp)
+	}
+
+	// DNS over TLS: refused, not left to time out.
+	dot := greet()
+	defer dot.Close()
+	_, _ = dot.Write([]byte{5, 1, 0, 1, 198, 18, 0, 2, 3, 85})
+	if rep := readN(t, dot, 10); rep[1] != statute.RepConnectionRefused {
+		t.Fatalf("853 got reply %d, want refused", rep[1])
+	}
+}
