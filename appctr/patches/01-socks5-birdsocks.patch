@@ -0,0 +1,155 @@
+package netstack
+
+// searchdomains.go — BirdSocks: short names. A desktop client hands NetBird's
+// search domains to the system resolver, so "sleeperpc" finds
+// sleeperpc.<domain>; in netstack mode there is no system resolver to hand
+// them to, and the proxies resolve names themselves. The engine supplies the
+// list here, and both proxies try a single-label name under each domain.
+
+import (
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+var searchDomains struct {
+	sync.RWMutex
+	source func() []string
+}
+
+// SetSearchDomains supplies NetBird's current search domains; the engine
+// calls it once its DNS server exists.
+func SetSearchDomains(source func() []string) {
+	searchDomains.Lock()
+	searchDomains.source = source
+	searchDomains.Unlock()
+}
+
+func currentSearchDomains() []string {
+	searchDomains.RLock()
+	defer searchDomains.RUnlock()
+	if searchDomains.source == nil {
+		return nil
+	}
+	return searchDomains.source()
+}
+
+// singleLabel reports whether name, with or without its trailing dot, has no
+// dot of its own: the names search domains apply to.
+func singleLabel(name string) bool {
+	n := strings.TrimSuffix(name, ".")
+	return n != "" && !strings.Contains(n, ".")
+}
+
+// expansions are the names to try for a single-label name, in order.
+func expansions(name string) []string {
+	if !singleLabel(name) || strings.EqualFold(strings.TrimSuffix(name, "."), "localhost") {
+		return nil
+	}
+	n := strings.TrimSuffix(name, ".")
+	var out []string
+	for _, d := range currentSearchDomains() {
+		if d = strings.Trim(d, "."); d != "" {
+			out = append(out, n+"."+d)
+		}
+	}
+	return out
+}
+
+// ownDomains are the domains NetBird answers for itself or forwards to the
+// account's nameservers: its peers' zone, custom zones, nameserver groups'
+// match domains. The DNS proxies never send those names to a public
+// resolver — a NetBird failure stays a failure instead of leaking the name
+// (and, worse, answering it from outside).
+var ownDomains struct {
+	sync.RWMutex
+	source func() []string
+}
+
+// SetOwnDomains supplies NetBird's own domains; the engine calls it beside
+// SetSearchDomains.
+func SetOwnDomains(source func() []string) {
+	ownDomains.Lock()
+	ownDomains.source = source
+	ownDomains.Unlock()
+}
+
+// ownName reports whether name (lower case, a trailing dot or none) is one
+// of NetBird's: under its own or search domains, or the reverse name of an
+// address in the NetBird network.
+func ownName(name string) bool {
+	n := strings.TrimSuffix(strings.ToLower(name), ".")
+	if n == "" {
+		return false
+	}
+	if ip, ok := reverseAddr(n); ok {
+		routes.Lock()
+		defer routes.Unlock()
+		for _, p := range routes.overlay {
+			if p.Contains(ip) {
+				return true
+			}
+		}
+		return false
+	}
+	ownDomains.RLock()
+	src := ownDomains.source
+	ownDomains.RUnlock()
+	var domains []string
+	if src != nil {
+		domains = src()
+	}
+	domains = append(domains, currentSearchDomains()...)
+	for _, d := range domains {
+		d = strings.TrimSuffix(strings.ToLower(strings.TrimSpace(d)), ".")
+		if d == "" {
+			continue
+		}
+		if n == d || strings.HasSuffix(n, "."+d) {
+			return true
+		}
+	}
+	return false
+}
+
+// reverseAddr is the address a PTR name stands for: 4.3.2.1.in-addr.arpa
+// or the 32 nibbles of ip6.arpa.
+func reverseAddr(n string) (netip.Addr, bool) {
+	if rest, ok := strings.CutSuffix(n, ".in-addr.arpa"); ok {
+		labels := strings.Split(rest, ".")
+		if len(labels) != 4 {
+			return netip.Addr{}, false
+		}
+		var b [4]byte
+		for i, l := range labels {
+			v, err := strconv.ParseUint(l, 10, 8)
+			if err != nil {
+				return netip.Addr{}, false
+			}
+			b[3-i] = byte(v)
+		}
+		return netip.AddrFrom4(b), true
+	}
+	if rest, ok := strings.CutSuffix(n, ".ip6.arpa"); ok {
+		labels := strings.Split(rest, ".")
+		if len(labels) != 32 {
+			return netip.Addr{}, false
+		}
+		var b [16]byte
+		for i, l := range labels {
+			v, err := strconv.ParseUint(l, 16, 4)
+			if err != nil || len(l) != 1 {
+				return netip.Addr{}, false
+			}
+			pos := 31 - i
+			if pos%2 == 0 {
+				b[pos/2] |= byte(v) << 4
+			} else {
+				b[pos/2] |= byte(v)
+			}
+		}
+		return netip.AddrFrom16(b), true
+	}
+	return netip.Addr{}, false
+}
