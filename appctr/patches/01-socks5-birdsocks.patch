+package netstack
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// resetFront puts the daemon's proxy state back as it was, after setting
+// when the last engine stopped (or the daemon started).
+func resetFront(t *testing.T, since time.Time) {
+	t.Helper()
+	front.Lock()
+	saved := front.current
+	savedSince := front.since
+	front.current = nil
+	front.since = since
+	front.Unlock()
+	t.Cleanup(func() {
+		front.Lock()
+		front.current = saved
+		front.since = savedSince
+		front.Unlock()
+	})
+}
+
+func TestWaitBackendGetsTheArrivingEngine(t *testing.T) {
+	resetFront(t, time.Now())
+	b := &backend{}
+	go func() {
+		time.Sleep(200 * time.Millisecond)
+		setBackend(b)
+	}()
+	start := time.Now()
+	got := waitBackend(context.Background(), 3*time.Second)
+	if got != b {
+		t.Fatalf("got %v, want the new engine", got)
+	}
+	if took := time.Since(start); took > time.Second {
+		t.Fatalf("waited %v", took)
+	}
+}
+
+func TestNoEngineExpectedGoesDirectAtOnce(t *testing.T) {
+	resetFront(t, time.Now().Add(-time.Hour))
+	start := time.Now()
+	if got := waitBackend(context.Background(), 3*time.Second); got != nil {
+		t.Fatalf("got %v", got)
+	}
+	if took := time.Since(start); took > 50*time.Millisecond {
+		t.Fatalf("waited %v with no engine expected", took)
+	}
+}
+
+func TestExpectedEngineThatNeverComes(t *testing.T) {
+	resetFront(t, time.Now())
+	start := time.Now()
+	if got := waitBackend(context.Background(), 300*time.Millisecond); got != nil {
+		t.Fatalf("got %v", got)
+	}
+	if took := time.Since(start); took < 300*time.Millisecond || took > time.Second {
+		t.Fatalf("waited %v, want 300ms", took)
+	}
+}
+
+func TestClearBackendLeavesAnother(t *testing.T) {
+	resetFront(t, time.Now())
+	a, b := &backend{}, &backend{}
+	setBackend(a)
+	clearBackend(b) // an old engine stopping after a new one started
+	if got := waitBackend(context.Background(), 0); got != a {
+		t.Fatal("an old engine's stop withdrew the new one")
+	}
+	clearBackend(a)
+	front.Lock()
+	cur := front.current
+	front.Unlock()
+	if cur != nil {
+		t.Fatal("still in use after its stop")
+	}
+}
+
+func TestFrontDialsDirectWithoutEngine(t *testing.T) {
+	resetFront(t, time.Now().Add(-time.Hour))
+	withFake(t)
+	c, err := frontDialer{}.Dial(context.Background(), "tcp", "192.0.2.3:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+}
