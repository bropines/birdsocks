+++ netbird_src/client/iface/netstack/route.go
@@ -0,0 +1,265 @@
+package netstack
+
+// route.go — BirdSocks: which destinations the SOCKS5 proxy sends through
+// the tunnel. Upstream sends everything there, which leaves an app with no
+// way out to the internet unless an exit node is in use.
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+
+	"github.com/netbirdio/netbird/client/internal/anet"
+)
+
+// routeRefresh bounds how stale the cached peer routes may be.
+const routeRefresh = 2 * time.Second
+
+var routes struct {
+	sync.Mutex
+	overlay  []netip.Prefix         // the NetBird network, IPv4 and IPv6: peers, and the DNS address
+	dump     func() (string, error) // the WireGuard device's peer dump (IpcGet)
+	prefixes []netip.Prefix         // allowed IPs of every peer, at last read
+	read     time.Time
+}
+
+// routeMissRefresh: a destination no peer carries re-reads the dump when it
+// is older than this, so a route added a moment ago (a domain route the DNS
+// proxy just resolved) is not missed for the whole of routeRefresh.
+const routeMissRefresh = 300 * time.Millisecond
+
+// SetRouteSource tells the proxy the NetBird network and how to read the
+// WireGuard device's peers; the netstack device calls it once it exists.
+// Until it does, everything goes through the tunnel, as upstream.
+func SetRouteSource(overlay, overlay6 netip.Prefix, dump func() (string, error)) {
+	routes.Lock()
+	defer routes.Unlock()
+	routes.overlay = nil
+	for _, p := range []netip.Prefix{overlay, overlay6} {
+		if p.IsValid() {
+			routes.overlay = append(routes.overlay, p.Masked())
+		}
+	}
+	routes.dump, routes.prefixes, routes.read = dump, nil, time.Time{}
+}
+
+// overlayDestination reports whether addr ("ip:port") is reached through
+// the tunnel: the NetBird network, and whatever a peer routes. A match on a
+// default route alone (an exit node) leaves the device's own surroundings
+// out — loopback, link-local and the subnets it is attached to — as a
+// desktop's connected routes win over an exit node's default route.
+func overlayDestination(addr string) bool {
+	host, _, err := net.SplitHostPort(addr)
+	if err != nil {
+		return true
+	}
+	ip, err := netip.ParseAddr(host)
+	if err != nil {
+		return true
+	}
+	ip = ip.Unmap()
+	routes.Lock()
+	if routes.dump == nil {
+		routes.Unlock()
+		return true
+	}
+	for _, p := range routes.overlay {
+		if p.Contains(ip) {
+			routes.Unlock()
+			return true
+		}
+	}
+	if time.Since(routes.read) > routeRefresh {
+		routes.prefixes = allowedIPs(routes.dump)
+		routes.read = time.Now()
+	}
+	best := longestMatch(routes.prefixes, ip)
+	if best < 0 && time.Since(routes.read) > routeMissRefresh {
+		routes.prefixes = allowedIPs(routes.dump)
+		routes.read = time.Now()
+		best = longestMatch(routes.prefixes, ip)
+	}
+	routes.Unlock()
+	switch {
+	case best < 0:
+		return false
+	case best == 0:
+		return !localDestination(ip)
+	default:
+		return true
+	}
+}
+
+// longestMatch is the prefix length of the most specific prefix holding ip,
+// or -1 when none does.
+func longestMatch(prefixes []netip.Prefix, ip netip.Addr) int {
+	best := -1
+	for _, p := range prefixes {
+		if p.Contains(ip) && p.Bits() > best {
+			best = p.Bits()
+		}
+	}
+	return best
+}
+
+var localNets struct {
+	sync.Mutex
+	prefixes []netip.Prefix
+	read     time.Time
+}
+
+// localDestination: an address on this device or a network it is attached to.
+func localDestination(ip netip.Addr) bool {
+	if ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsLinkLocalMulticast() || ip.IsMulticast() || ip.IsUnspecified() {
+		return true
+	}
+	localNets.Lock()
+	defer localNets.Unlock()
+	if time.Since(localNets.read) > 10*time.Second {
+		localNets.prefixes = attachedPrefixes()
+		localNets.read = time.Now()
+	}
+	for _, p := range localNets.prefixes {
+		if p.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// attachedPrefixes are the subnets of the device's interfaces. anet: inside
+// an Android app the standard library cannot list them.
+func attachedPrefixes() []netip.Prefix {
+	ifaces, err := anet.Interfaces()
+	if err != nil {
+		log.Debugf("socks5: interfaces not read: %v", err)
+		return nil
+	}
+	var out []netip.Prefix
+	for i := range ifaces {
+		if ifaces[i].Flags&net.FlagUp == 0 {
+			continue
+		}
+		addrs, err := anet.InterfaceAddrsByInterface(&ifaces[i])
+		if err != nil {
+			continue
+		}
+		for _, a := range addrs {
+			ipn, ok := a.(*net.IPNet)
+			if !ok {
+				continue
+			}
+			addr, ok := netip.AddrFromSlice(ipn.IP)
+			if !ok {
+				continue
+			}
+			bits, _ := ipn.Mask.Size()
+			if p := netip.PrefixFrom(addr.Unmap(), bits).Masked(); p.Bits() > 0 {
+				out = append(out, p)
+			}
+		}
+	}
+	return out
+}
+
+// allowedIPs reads every peer's allowed_ip lines from a UAPI dump.
+func allowedIPs(dump func() (string, error)) []netip.Prefix {
+	text, err := dump()
+	if err != nil {
+		log.Debugf("socks5: peer routes not read: %v", err)
+		return nil
+	}
+	var out []netip.Prefix
+	sc := bufio.NewScanner(strings.NewReader(text))
+	for sc.Scan() {
+		v, ok := strings.CutPrefix(sc.Text(), "allowed_ip=")
+		if !ok {
+			continue
+		}
+		if p, err := netip.ParsePrefix(v); err == nil {
+			out = append(out, p.Masked())
+		}
+	}
+	return out
+}
+
+// nsResolver resolves names for the proxy with NetBird's DNS first — peer
+// names and the account's zones are only there — and the host's resolver
+// when that has no answer. Upstream asked the host only, so no peer name
+// resolved through the proxy.
+type nsResolver struct{ net *netstack.Net }
+
+func newNSResolver(n *netstack.Net) *nsResolver { return &nsResolver{net: n} }
+
+func (r *nsResolver) Resolve(ctx context.Context, name string) (context.Context, net.IP, error) {
+	// A short name: NetBird's search domains first, as a system resolver would.
+	for _, full := range expansions(name) {
+		tctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+		addrs, err := r.net.LookupContextHost(tctx, full)
+		cancel()
+		if err == nil {
+			if ip := pickIP(addrs); ip != nil {
+				alternatives.put(ip, parseIPs(addrs))
+				return ctx, ip, nil
+			}
+		}
+	}
+	tctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	addrs, err := r.net.LookupContextHost(tctx, name)
+	cancel()
+	if err == nil {
+		if ip := pickIP(addrs); ip != nil {
+			alternatives.put(ip, parseIPs(addrs))
+			return ctx, ip, nil
+		}
+	}
+	ips, err := net.DefaultResolver.LookupIP(ctx, "ip", name)
+	if err != nil {
+		return ctx, nil, err
+	}
+	chosen := ips[0]
+	for _, ip := range ips {
+		if ip.To4() != nil {
+			chosen = ip
+			break
+		}
+	}
+	// The other addresses are what the direct dial falls back to.
+	alternatives.put(chosen, ips)
+	return ctx, chosen, nil
+}
+
+func parseIPs(addrs []string) []net.IP {
+	out := make([]net.IP, 0, len(addrs))
+	for _, a := range addrs {
+		if ip := net.ParseIP(a); ip != nil {
+			out = append(out, ip)
+		}
+	}
+	return out
+}
+
+// pickIP prefers an IPv4 address, as NetBird networks are IPv4 first.
+func pickIP(addrs []string) net.IP {
+	var first net.IP
+	for _, a := range addrs {
+		ip := net.ParseIP(a)
+		if ip == nil {
+			continue
+		}
+		if ip.To4() != nil {
+			return ip
+		}
+		if first == nil {
+			first = ip
+		}
+	}
+	return first
+}
--- netbird_orig/client/iface/netstack/route_test.go
+++ netbird_src/client/iface/netstack/route_test.go
@@ -0,0 +1,87 @@
+package netstack
+
+import (
+	"net/netip"
+	"testing"
+	"time"
+)
+
+var (
+	overlay4 = netip.MustParsePrefix("100.90.0.0/16")
+	overlay6 = netip.MustParsePrefix("fd00:1234::/64")
+)
+
+func TestOverlayDestination(t *testing.T) {
+	dump := "private_key=00\npublic_key=aa\nallowed_ip=100.90.1.2/32\nallowed_ip=10.10.0.0/16\npublic_key=bb\nallowed_ip=100.90.1.3/32\n"
+	SetRouteSource(overlay4, overlay6, func() (string, error) { return dump, nil })
+	defer SetRouteSource(netip.Prefix{}, netip.Prefix{}, nil)
+
+	for addr, want := range map[string]bool{
+		"100.90.1.2:80":     true,  // a peer
+		"100.90.255.254:53": true,  // the network's DNS address, no peer carries it
+		"[fd00:1234::5]:80": true,  // the IPv6 overlay
+		"10.10.5.5:443":     true,  // a routed network
+		"1.1.1.1:443":       false, // the internet, no exit node
+		"[::1]:80":          false,
+	} {
+		if got := overlayDestination(addr); got != want {
+			t.Errorf("%s: got %v, want %v", addr, got, want)
+		}
+	}
+
+	dump += "public_key=cc\nallowed_ip=0.0.0.0/0\n"
+	SetRouteSource(overlay4, overlay6, func() (string, error) { return dump, nil })
+	if !overlayDestination("1.1.1.1:443") {
+		t.Error("with an exit node the internet goes through the tunnel")
+	}
+	if overlayDestination("127.0.0.1:80") || overlayDestination("[fe80::1]:80") || overlayDestination("169.254.1.1:80") {
+		t.Error("loopback and link-local stay on the device with an exit node")
+	}
+	if !overlayDestination("10.10.5.5:443") {
+		t.Error("a network a peer routes wins over the exit node's default route")
+	}
+}
+
+// The device's own subnets bypass an exit node; a peer's route for the same
+// subnet still wins.
+func TestExitNodeLeavesAttachedSubnets(t *testing.T) {
+	localNets.Lock()
+	localNets.prefixes = []netip.Prefix{netip.MustParsePrefix("192.168.1.0/24")}
+	localNets.read = time.Now()
+	localNets.Unlock()
+	defer func() { localNets.Lock(); localNets.read = time.Time{}; localNets.Unlock() }()
+
+	dump := "public_key=cc\nallowed_ip=0.0.0.0/0\n"
+	SetRouteSource(overlay4, overlay6, func() (string, error) { return dump, nil })
+	defer SetRouteSource(netip.Prefix{}, netip.Prefix{}, nil)
+	if overlayDestination("192.168.1.10:80") {
+		t.Error("the LAN went into the exit node")
+	}
+	dump += "public_key=dd\nallowed_ip=192.168.1.0/24\n"
+	SetRouteSource(overlay4, overlay6, func() (string, error) { return dump, nil })
+	if !overlayDestination("192.168.1.10:80") {
+		t.Error("a peer routing the same subnet must win")
+	}
+}
+
+// A route added after the last read is seen on the next miss, not 2 s later.
+func TestMissRereadsTheDump(t *testing.T) {
+	dump := "public_key=aa\nallowed_ip=100.90.1.2/32\n"
+	SetRouteSource(overlay4, overlay6, func() (string, error) { return dump, nil })
+	defer SetRouteSource(netip.Prefix{}, netip.Prefix{}, nil)
+	if overlayDestination("203.0.113.7:443") {
+		t.Fatal("unrouted destination went into the tunnel")
+	}
+	dump += "allowed_ip=203.0.113.7/32\n"
+	time.Sleep(routeMissRefresh + 50*time.Millisecond)
+	if !overlayDestination("203.0.113.7:443") {
+		t.Error("a freshly added /32 was missed")
+	}
+}
+
+func TestOverlayDestinationBeforeTheDevice(t *testing.T) {
+	SetRouteSource(netip.Prefix{}, netip.Prefix{}, nil)
+	if !overlayDestination("1.1.1.1:443") {
+		t.Error("without a route source everything goes through the tunnel, as upstream")
+	}
+}
