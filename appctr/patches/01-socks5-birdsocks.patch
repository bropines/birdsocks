--- netbird_orig/client/iface/netstack/route.go
+++ netbird_src/client/iface/netstack/route.go
@@ -0,0 +1,138 @@
+package netstack
+
+// route.go — BirdSocks: which destinations the SOCKS5 proxy sends through
+// the tunnel. Upstream sends everything there, which leaves an app with no
+// way out to the internet unless an exit node is in use.
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+// routeRefresh bounds how stale the cached peer routes may be.
+const routeRefresh = 2 * time.Second
+
+var routes struct {
+	sync.Mutex
+	overlay  netip.Prefix           // the NetBird network: peers, and its DNS address
+	dump     func() (string, error) // the WireGuard device's peer dump (IpcGet)
+	prefixes []netip.Prefix         // allowed IPs of every peer, at last read
+	read     time.Time
+}
+
+// SetRouteSource tells the proxy the NetBird network and how to read the
+// WireGuard device's peers; the netstack device calls it once it exists.
+// Until it does, everything goes through the tunnel, as upstream.
+func SetRouteSource(overlay netip.Prefix, dump func() (string, error)) {
+	routes.Lock()
+	defer routes.Unlock()
+	routes.overlay, routes.dump, routes.prefixes, routes.read = overlay, dump, nil, time.Time{}
+}
+
+// overlayDestination reports whether addr ("ip:port") is reached through
+// the tunnel.
+func overlayDestination(addr string) bool {
+	host, _, err := net.SplitHostPort(addr)
+	if err != nil {
+		return true
+	}
+	ip, err := netip.ParseAddr(host)
+	if err != nil {
+		return true
+	}
+	ip = ip.Unmap()
+	routes.Lock()
+	defer routes.Unlock()
+	if routes.dump == nil {
+		return true
+	}
+	if routes.overlay.IsValid() && routes.overlay.Contains(ip) {
+		return true
+	}
+	if time.Since(routes.read) > routeRefresh {
+		routes.prefixes = allowedIPs(routes.dump)
+		routes.read = time.Now()
+	}
+	for _, p := range routes.prefixes {
+		if p.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// allowedIPs reads every peer's allowed_ip lines from a UAPI dump.
+func allowedIPs(dump func() (string, error)) []netip.Prefix {
+	text, err := dump()
+	if err != nil {
+		log.Debugf("socks5: peer routes not read: %v", err)
+		return nil
+	}
+	var out []netip.Prefix
+	sc := bufio.NewScanner(strings.NewReader(text))
+	for sc.Scan() {
+		v, ok := strings.CutPrefix(sc.Text(), "allowed_ip=")
+		if !ok {
+			continue
+		}
+		if p, err := netip.ParsePrefix(v); err == nil {
+			out = append(out, p.Masked())
+		}
+	}
+	return out
+}
+
+// nsResolver resolves names for the proxy with NetBird's DNS first — peer
+// names and the account's zones are only there — and the host's resolver
+// when that has no answer. Upstream asked the host only, so no peer name
+// resolved through the proxy.
+type nsResolver struct{ net *netstack.Net }
+
+func newNSResolver(n *netstack.Net) *nsResolver { return &nsResolver{net: n} }
+
+func (r *nsResolver) Resolve(ctx context.Context, name string) (context.Context, net.IP, error) {
+	tctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	addrs, err := r.net.LookupContextHost(tctx, name)
+	cancel()
+	if err == nil {
+		if ip := pickIP(addrs); ip != nil {
+			return ctx, ip, nil
+		}
+	}
+	ips, err := net.DefaultResolver.LookupIP(ctx, "ip", name)
+	if err != nil {
+		return ctx, nil, err
+	}
+	for _, ip := range ips {
+		if ip.To4() != nil {
+			return ctx, ip, nil
+		}
+	}
+	return ctx, ips[0], nil
+}
+
+// pickIP prefers an IPv4 address, as NetBird networks are IPv4 first.
+func pickIP(addrs []string) net.IP {
+	var first net.IP
+	for _, a := range addrs {
+		ip := net.ParseIP(a)
+		if ip == nil {
+			continue
+		}
+		if ip.To4() != nil {
+			return ip
+		}
+		if first == nil {
+			first = ip
+		}
+	}
+	return first
+}
--- netbird_orig/client/iface/netstack/route_test.go
+++ netbird_src/client/iface/netstack/route_test.go
@@ -0,0 +1,37 @@
+package netstack
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestOverlayDestination(t *testing.T) {
+	dump := "private_key=00\npublic_key=aa\nallowed_ip=100.90.1.2/32\nallowed_ip=10.10.0.0/16\npublic_key=bb\nallowed_ip=100.90.1.3/32\n"
+	SetRouteSource(netip.MustParsePrefix("100.90.0.0/16"), func() (string, error) { return dump, nil })
+	defer SetRouteSource(netip.Prefix{}, nil)
+
+	for addr, want := range map[string]bool{
+		"100.90.1.2:80":     true,  // a peer
+		"100.90.255.254:53": true,  // the network's DNS address, no peer carries it
+		"10.10.5.5:443":     true,  // a routed network
+		"1.1.1.1:443":       false, // the internet, no exit node
+		"[::1]:80":          false,
+	} {
+		if got := overlayDestination(addr); got != want {
+			t.Errorf("%s: got %v, want %v", addr, got, want)
+		}
+	}
+
+	dump += "public_key=cc\nallowed_ip=0.0.0.0/0\n"
+	SetRouteSource(netip.MustParsePrefix("100.90.0.0/16"), func() (string, error) { return dump, nil })
+	if !overlayDestination("1.1.1.1:443") {
+		t.Error("with an exit node the internet goes through the tunnel")
+	}
+}
+
+func TestOverlayDestinationBeforeTheDevice(t *testing.T) {
+	SetRouteSource(netip.Prefix{}, nil)
+	if !overlayDestination("1.1.1.1:443") {
+		t.Error("without a route source everything goes through the tunnel, as upstream")
+	}
+}
--- netbird_orig/client/iface/netstack/dnsproxy.go
+++ netbird_src/client/iface/netstack/dnsproxy.go
@@ -0,0 +1,158 @@
+package netstack
+
+// dnsproxy.go — BirdSocks: a plain DNS server on the host side of the
+// daemon, for apps and ad-blockers that take a DNS address rather than a
+// proxy. A query goes to NetBird's own resolver first, through the netstack
+// (peer names, the account's zones and nameserver groups are only there);
+// what NetBird has no handler for (REFUSED) or cannot answer (SERVFAIL) goes
+// to the network's resolvers.
+
+import (
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+// EnvDNSProxyAddress is where the DNS proxy listens, host:port; unset, there
+// is none.
+const EnvDNSProxyAddress = "NB_DNS_PROXY_ADDRESS"
+
+const dnsTimeout = 3 * time.Second
+
+var fallbackDNS struct {
+	sync.RWMutex
+	servers func() []string
+}
+
+// SetFallbackDNS supplies the network's resolvers ("ip:port" each), asked for
+// what NetBird does not answer. The daemon's entry point owns them.
+func SetFallbackDNS(f func() []string) {
+	fallbackDNS.Lock()
+	fallbackDNS.servers = f
+	fallbackDNS.Unlock()
+}
+
+func fallbackServers() []string {
+	fallbackDNS.RLock()
+	defer fallbackDNS.RUnlock()
+	if fallbackDNS.servers == nil {
+		return []string{"8.8.8.8:53", "1.1.1.1:53"}
+	}
+	return fallbackDNS.servers()
+}
+
+type dnsProxy struct {
+	pc     net.PacketConn
+	tunNet *netstack.Net
+	nbDNS  netip.AddrPort
+	closed atomic.Bool
+}
+
+func startDNSProxy(addr string, tunNet *netstack.Net, dnsAddr netip.Addr) (*dnsProxy, error) {
+	network := "udp"
+	if ap, err := netip.ParseAddrPort(addr); err == nil && ap.Addr().Is4() {
+		network = "udp4"
+	}
+	pc, err := net.ListenPacket(network, addr)
+	if err != nil {
+		return nil, err
+	}
+	p := &dnsProxy{pc: pc, tunNet: tunNet, nbDNS: netip.AddrPortFrom(dnsAddr, 53)}
+	log.Infof("DNS proxy listening on %s, NetBird's resolver %s first", addr, p.nbDNS)
+	go p.serve()
+	return p, nil
+}
+
+func (p *dnsProxy) Close() error {
+	p.closed.Store(true)
+	return p.pc.Close()
+}
+
+func (p *dnsProxy) serve() {
+	buf := make([]byte, 65535)
+	for {
+		n, from, err := p.pc.ReadFrom(buf)
+		if err != nil {
+			if !p.closed.Load() {
+				log.Errorf("DNS proxy: %v", err)
+			}
+			return
+		}
+		if n < 12 {
+			continue
+		}
+		q := make([]byte, n)
+		copy(q, buf[:n])
+		go func() {
+			if resp := p.resolve(q); resp != nil {
+				_, _ = p.pc.WriteTo(resp, from)
+			}
+		}()
+	}
+}
+
+// resolve answers one query: NetBird's resolver, then the network's.
+func (p *dnsProxy) resolve(q []byte) []byte {
+	nb, err := p.askNetBird(q)
+	if err == nil && !retryable(nb) {
+		return nb
+	}
+	for _, s := range fallbackServers() {
+		if resp, err := askUDP(q, s); err == nil {
+			return resp
+		}
+	}
+	// Nothing better: NetBird's own answer, SERVFAIL or REFUSED as it is.
+	return nb
+}
+
+// retryable is a response someone else may answer: no handler for the name
+// (REFUSED) or no upstream reachable (SERVFAIL).
+func retryable(resp []byte) bool {
+	if len(resp) < 4 {
+		return true
+	}
+	rcode := resp[3] & 0x0f
+	return rcode == 2 || rcode == 5
+}
+
+func (p *dnsProxy) askNetBird(q []byte) ([]byte, error) {
+	conn, err := p.tunNet.DialUDPAddrPort(netip.AddrPort{}, p.nbDNS)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	return exchange(conn, q)
+}
+
+func askUDP(q []byte, server string) ([]byte, error) {
+	conn, err := net.DialTimeout("udp", server, dnsTimeout)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	return exchange(conn, q)
+}
+
+// exchange sends q on conn and reads the response with q's id.
+func exchange(conn net.Conn, q []byte) ([]byte, error) {
+	_ = conn.SetDeadline(time.Now().Add(dnsTimeout))
+	if _, err := conn.Write(q); err != nil {
+		return nil, err
+	}
+	buf := make([]byte, 65535)
+	for {
+		n, err := conn.Read(buf)
+		if err != nil {
+			return nil, err
+		}
+		if n >= 12 && buf[0] == q[0] && buf[1] == q[1] {
+			return append([]byte(nil), buf[:n]...), nil
+		}
+	}
+}
