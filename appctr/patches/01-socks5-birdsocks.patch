+package netstack
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestExpansions(t *testing.T) {
+	SetSearchDomains(func() []string { return []string{"corp.example.", "example.com"} })
+	defer SetSearchDomains(nil)
+	if got := expansions("sleeperpc."); !reflect.DeepEqual(got, []string{"sleeperpc.corp.example", "sleeperpc.example.com"}) {
+		t.Errorf("short name: %v", got)
+	}
+	if got := expansions("argocd-internal"); len(got) != 2 {
+		t.Errorf("short name without the root dot: %v", got)
+	}
+	if got := expansions("ams.corp.example."); got != nil {
+		t.Errorf("a dotted name must not be expanded: %v", got)
+	}
+	SetSearchDomains(nil)
+	if got := expansions("sleeperpc"); got != nil {
+		t.Errorf("no domains: %v", got)
+	}
+}
--- netbird_orig/client/iface/netstack/fallback.go
+++ netbird_src/client/iface/netstack/fallback.go
@@ -0,0 +1,150 @@
+package netstack
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+)
+
+// fallbackDelay is how long a direct dial waits on one address before it
+// tries the name's next one alongside: a CDN's addresses are blocked one by
+// one on some networks, and a browser moves on instead of hanging.
+const fallbackDelay = 750 * time.Millisecond
+
+// alternatives remembers, for a minute, every address of the names the
+// proxy resolved, keyed by the one it handed out, so the direct dial can
+// fall back to the others.
+var alternatives = &altCache{entries: map[string]altEntry{}}
+
+type altEntry struct {
+	addrs []net.IP
+	until time.Time
+}
+
+type altCache struct {
+	mu      sync.Mutex
+	entries map[string]altEntry
+}
+
+const altCacheMax = 1024
+
+// put records all of a name's addresses under chosen, chosen first.
+func (c *altCache) put(chosen net.IP, all []net.IP) {
+	if len(all) < 2 {
+		return
+	}
+	ordered := []net.IP{chosen}
+	for _, v4 := range []bool{chosen.To4() != nil, chosen.To4() == nil} {
+		for _, ip := range all {
+			if !ip.Equal(chosen) && (ip.To4() != nil) == v4 {
+				ordered = append(ordered, ip)
+			}
+		}
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.entries) >= altCacheMax {
+		c.entries = map[string]altEntry{}
+	}
+	c.entries[chosen.String()] = altEntry{addrs: ordered, until: time.Now().Add(time.Minute)}
+}
+
+// get returns the addresses to try for host, the given one first.
+func (c *altCache) get(host string) []net.IP {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e, ok := c.entries[host]
+	if !ok || time.Now().After(e.until) {
+		return nil
+	}
+	return e.addrs
+}
+
+// dialFunc is the plain dial a fallback dial is made of; tests replace it.
+var dialFunc = func(ctx context.Context, network, addr string) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, network, addr)
+}
+
+// dialDirect dials addr over the host's network; for TCP to an address the
+// proxy resolved from a name, the name's other addresses follow, staggered.
+func dialDirect(ctx context.Context, network, addr string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil || (network != "tcp" && network != "tcp4" && network != "tcp6") {
+		return dialFunc(ctx, network, addr)
+	}
+	alts := alternatives.get(host)
+	if len(alts) < 2 {
+		return dialFunc(ctx, network, addr)
+	}
+	addrs := make([]string, 0, len(alts))
+	for _, ip := range alts {
+		addrs = append(addrs, net.JoinHostPort(ip.String(), port))
+	}
+	return dialStaggered(ctx, network, addrs)
+}
+
+// dialStaggered dials addrs[0], starts the next address when the last one
+// failed or has not connected within fallbackDelay, and returns the first
+// connection made; the losers are closed.
+func dialStaggered(ctx context.Context, network string, addrs []string) (net.Conn, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	type result struct {
+		conn net.Conn
+		err  error
+	}
+	results := make(chan result, len(addrs))
+	dial := dialFunc
+	pending, next := 0, 0
+	start := func() {
+		a := addrs[next]
+		next++
+		pending++
+		go func() {
+			c, err := dial(ctx, network, a)
+			results <- result{c, err}
+		}()
+	}
+	// The dials still running when one wins are drained and closed.
+	drain := func(n int) {
+		go func() {
+			for i := 0; i < n; i++ {
+				if r := <-results; r.conn != nil {
+					_ = r.conn.Close()
+				}
+			}
+		}()
+	}
+	start()
+	timer := time.NewTimer(fallbackDelay)
+	defer timer.Stop()
+	var firstErr error
+	for pending > 0 {
+		select {
+		case r := <-results:
+			pending--
+			if r.err == nil {
+				drain(pending)
+				return r.conn, nil
+			}
+			if firstErr == nil {
+				firstErr = r.err
+			}
+			if next < len(addrs) {
+				start()
+				timer.Reset(fallbackDelay)
+			}
+		case <-timer.C:
+			if next < len(addrs) {
+				start()
+				timer.Reset(fallbackDelay)
+			}
+		case <-ctx.Done():
+			drain(pending)
+			return nil, ctx.Err()
+		}
+	}
+	return nil, firstErr
+}
--- netbird_orig/client/iface/netstack/fallback_test.go
+++ netbird_src/client/iface/netstack/fallback_test.go
@@ -0,0 +1,106 @@
+package netstack
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// fakeDial: "hang" never connects until ctx ends, "fail" fails at once,
+// anything else connects over a pipe.
+func fakeDial(t *testing.T, closed *atomic.Int32) func(ctx context.Context, network, addr string) (net.Conn, error) {
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		host, _, _ := net.SplitHostPort(addr)
+		switch host {
+		case "192.0.2.1": // hangs
+			<-ctx.Done()
+			return nil, ctx.Err()
+		case "192.0.2.2": // refused
+			return nil, errors.New("refused")
+		}
+		a, b := net.Pipe()
+		go func() { <-ctx.Done(); _ = b.Close() }()
+		return &countingConn{Conn: a, closed: closed}, nil
+	}
+}
+
+type countingConn struct {
+	net.Conn
+	closed *atomic.Int32
+}
+
+func (c *countingConn) Close() error { c.closed.Add(1); return c.Conn.Close() }
+
+func withFake(t *testing.T) *atomic.Int32 {
+	var closed atomic.Int32
+	old := dialFunc
+	dialFunc = fakeDial(t, &closed)
+	t.Cleanup(func() { dialFunc = old })
+	return &closed
+}
+
+func TestHangingFirstAddressFallsBack(t *testing.T) {
+	withFake(t)
+	start := time.Now()
+	c, err := dialStaggered(context.Background(), "tcp", []string{"192.0.2.1:443", "192.0.2.3:443"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if took := time.Since(start); took < fallbackDelay || took > fallbackDelay+time.Second {
+		t.Fatalf("connected after %v, want about %v", took, fallbackDelay)
+	}
+}
+
+func TestRefusedFirstAddressFallsBackAtOnce(t *testing.T) {
+	withFake(t)
+	start := time.Now()
+	c, err := dialStaggered(context.Background(), "tcp", []string{"192.0.2.2:443", "192.0.2.3:443"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if took := time.Since(start); took > 500*time.Millisecond {
+		t.Fatalf("connected after %v; a refusal should move on at once", took)
+	}
+}
+
+func TestAllFail(t *testing.T) {
+	withFake(t)
+	_, err := dialStaggered(context.Background(), "tcp", []string{"192.0.2.2:443", "192.0.2.2:80"})
+	if err == nil {
+		t.Fatal("connected to nothing")
+	}
+}
+
+func TestDirectDialUsesRememberedAddresses(t *testing.T) {
+	withFake(t)
+	alternatives.put(net.ParseIP("192.0.2.1"), []net.IP{net.ParseIP("192.0.2.1"), net.ParseIP("192.0.2.3")})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	c, err := dialDirect(ctx, "tcp", "192.0.2.1:443")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+	// Unknown addresses dial once, as before.
+	ctx2, cancel2 := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel2()
+	if _, err := dialDirect(ctx2, "tcp", "192.0.2.9:443"); err != nil {
+		t.Fatalf("plain dial: %v", err)
+	}
+}
+
+func TestAltOrderPrefersChosenFamily(t *testing.T) {
+	c := &altCache{entries: map[string]altEntry{}}
+	v6 := net.ParseIP("2001:db8::1")
+	a, b := net.ParseIP("198.51.100.1"), net.ParseIP("198.51.100.2")
+	c.put(b, []net.IP{v6, a, b})
+	got := c.get("198.51.100.2")
+	if len(got) != 3 || !got[0].Equal(b) || !got[1].Equal(a) || !got[2].Equal(v6) {
+		t.Fatalf("order %v", got)
+	}
+}
--- netbird_orig/client/iface/netstack/front.go
+++ netbird_src/client/iface/netstack/front.go
@@ -0,0 +1,202 @@
+package netstack
+
+// front.go — BirdSocks: the SOCKS5 proxy and the DNS proxy belong to the
+// daemon, not to one engine. An engine lends them its netstack while it runs;
+// between engines — a reconnect, a profile switch, an expired session, no
+// login yet — they keep serving, straight to the internet, so the apps behind
+// them are not cut off. A connection that comes while an engine is on its way
+// back waits for it a moment.
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+const (
+	// backendGrace: after the daemon starts or an engine stops, another
+	// engine is expected this long, and connections wait for it.
+	backendGrace = 15 * time.Second
+	// How long a connection or a DNS query waits for an expected engine.
+	backendWaitDial = 3 * time.Second
+	backendWaitDNS  = 1500 * time.Millisecond
+)
+
+// backend is what a running engine lends the proxies.
+type backend struct {
+	tunNet   *netstack.Net
+	dialer   *NSDialer
+	resolver *nsResolver
+	nbDNS    netip.AddrPort
+}
+
+func newBackend(tunNet *netstack.Net, dnsAddr netip.Addr) *backend {
+	dialer := NewNSDialer(tunNet)
+	dialer.resolver = newNSResolver(tunNet)
+	return &backend{tunNet: tunNet, dialer: dialer, resolver: dialer.resolver, nbDNS: netip.AddrPortFrom(dnsAddr, 53)}
+}
+
+var front = struct {
+	sync.Mutex
+	running bool
+	current *backend
+	since   time.Time     // daemon start or the last engine's stop
+	changed chan struct{} // closed when a backend arrives
+	proxy   *Proxy
+	dns     *dnsProxy
+}{changed: make(chan struct{})}
+
+// StartFront opens the SOCKS5 proxy (and the DNS proxy, when one is asked
+// for) for the life of the process; engines then only lend them a netstack.
+// Without it each engine opens and closes its own, as upstream does.
+func StartFront() error {
+	if v, _ := strconv.ParseBool(os.Getenv(EnvSkipProxy)); v {
+		return nil
+	}
+	front.Lock()
+	if front.running {
+		front.Unlock()
+		return nil
+	}
+	front.since = time.Now()
+	proxy, err := NewSocks5(frontDialer{}, frontResolver{})
+	if err != nil {
+		front.Unlock()
+		return err
+	}
+	front.proxy = proxy
+	front.running = true
+	front.Unlock()
+
+	addr := ListenAddr()
+	go func() {
+		if err := proxy.ListenAndServe(addr); err != nil {
+			log.Errorf("SOCKS5 proxy on %s: %v", addr, err)
+		}
+	}()
+	log.Infof("SOCKS5 proxy on %s for the daemon's life", addr)
+	if dnsAddr := os.Getenv(EnvDNSProxyAddress); dnsAddr != "" {
+		dp, err := startDNSProxy(dnsAddr, nil)
+		if err != nil {
+			log.Errorf("DNS proxy on %s: %v", dnsAddr, err)
+		} else {
+			front.Lock()
+			front.dns = dp
+			front.Unlock()
+		}
+	}
+	return nil
+}
+
+func frontRunning() bool {
+	front.Lock()
+	defer front.Unlock()
+	return front.running
+}
+
+// setBackend makes b the engine the proxies use, and wakes what waits for one.
+func setBackend(b *backend) {
+	front.Lock()
+	front.current = b
+	close(front.changed)
+	front.changed = make(chan struct{})
+	front.Unlock()
+}
+
+// clearBackend withdraws b when it is still the one in use.
+func clearBackend(b *backend) {
+	front.Lock()
+	if front.current == b {
+		front.current = nil
+		front.since = time.Now()
+	}
+	front.Unlock()
+}
+
+// waitBackend is the running engine's backend; while none runs but one is
+// expected (the daemon just started, or an engine just stopped), it waits
+// up to max for it. nil means: no engine, use the host's network.
+func waitBackend(ctx context.Context, max time.Duration) *backend {
+	front.Lock()
+	b, ch := front.current, front.changed
+	expected := time.Since(front.since) < backendGrace
+	front.Unlock()
+	if b != nil || !expected {
+		return b
+	}
+	t := time.NewTimer(max)
+	defer t.Stop()
+	for {
+		select {
+		case <-ch:
+			front.Lock()
+			b, ch = front.current, front.changed
+			front.Unlock()
+			if b != nil {
+				return b
+			}
+		case <-t.C:
+			return nil
+		case <-ctx.Done():
+			return nil
+		}
+	}
+}
+
+// frontDialer dials through the engine when one runs, directly otherwise.
+type frontDialer struct{}
+
+func (frontDialer) Dial(ctx context.Context, network, addr string) (net.Conn, error) {
+	// The VPN's resolver answers here with or without an engine (tundns.go).
+	if conn, handled, err := tunDNSDial(network, addr); handled {
+		return conn, err
+	}
+	if b := waitBackend(ctx, backendWaitDial); b != nil {
+		return b.dialer.Dial(ctx, network, addr)
+	}
+	// No engine: the internet alone. A UDP datagram may name its host.
+	if host, port, err := net.SplitHostPort(addr); err == nil {
+		if _, perr := netip.ParseAddr(host); perr != nil {
+			_, ip, rerr := frontResolver{}.Resolve(ctx, host)
+			if rerr != nil {
+				return nil, rerr
+			}
+			addr = net.JoinHostPort(ip.String(), port)
+		}
+	}
+	return dialDirect(ctx, network, addr)
+}
+
+// frontResolver resolves through the engine's DNS when one runs, through the
+// network's resolvers otherwise.
+type frontResolver struct{}
+
+func (frontResolver) Resolve(ctx context.Context, name string) (context.Context, net.IP, error) {
+	if b := waitBackend(ctx, backendWaitDial); b != nil {
+		return b.resolver.Resolve(ctx, name)
+	}
+	ips, err := net.DefaultResolver.LookupIP(ctx, "ip", name)
+	if err != nil {
+		return ctx, nil, err
+	}
+	if len(ips) == 0 {
+		return ctx, nil, errors.New("no address for " + name)
+	}
+	chosen := ips[0]
+	for _, ip := range ips {
+		if ip.To4() != nil {
+			chosen = ip
+			break
+		}
+	}
+	alternatives.put(chosen, ips)
+	return ctx, chosen, nil
+}
