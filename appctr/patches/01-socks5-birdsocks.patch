@@ -0,0 +1,469 @@
+package netstack
+
+// dnsproxy.go — BirdSocks: a plain DNS server on the host side of the
+// daemon, for apps and ad-blockers that take a DNS address rather than a
+// proxy, and the chain behind it, which the VPN mode's resolver shares
+// (tundns.go). A query goes to NetBird's own resolver first, through the
+// netstack (peer names, the account's zones and nameserver groups are only
+// there); what NetBird has no handler for (REFUSED) or cannot answer
+// (SERVFAIL) goes to the fallbacks, all at once — unless the name is
+// NetBird's own, which never leaves for a public resolver.
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+// EnvDNSProxyAddress is where the DNS proxy listens, host:port; unset, there
+// is none.
+const EnvDNSProxyAddress = "NB_DNS_PROXY_ADDRESS"
+
+// EnvDNSProxyUpstream, comma-separated host:port, replaces the network's
+// resolvers for what NetBird does not answer — another DNS proxy, say
+// TailSocks', so that every mesh name resolves the same whichever an
+// ad-blocker asks first.
+const EnvDNSProxyUpstream = "NB_DNS_PROXY_UPSTREAM"
+
+const dnsTimeout = 3 * time.Second
+
+var fallbackDNS struct {
+	sync.RWMutex
+	servers func() []string
+}
+
+// SetFallbackDNS supplies the network's resolvers ("ip:port" each), asked for
+// what NetBird does not answer. The daemon's entry point owns them.
+func SetFallbackDNS(f func() []string) {
+	fallbackDNS.Lock()
+	fallbackDNS.servers = f
+	fallbackDNS.Unlock()
+}
+
+func fallbackServers() []string {
+	if v := os.Getenv(EnvDNSProxyUpstream); v != "" {
+		var out []string
+		for _, s := range strings.Split(v, ",") {
+			if s = strings.TrimSpace(s); s != "" {
+				if _, _, err := net.SplitHostPort(s); err != nil {
+					s = net.JoinHostPort(s, "53")
+				}
+				out = append(out, s)
+			}
+		}
+		if len(out) > 0 {
+			return out
+		}
+	}
+	fallbackDNS.RLock()
+	defer fallbackDNS.RUnlock()
+	if fallbackDNS.servers == nil {
+		return []string{"8.8.8.8:53", "1.1.1.1:53"}
+	}
+	return fallbackDNS.servers()
+}
+
+type dnsProxy struct {
+	pc net.PacketConn
+	// fixed is the one engine an engine-owned proxy serves; nil for the
+	// daemon's proxy (front.go), which asks whichever engine runs.
+	fixed  *backend
+	closed atomic.Bool
+}
+
+func startDNSProxy(addr string, fixed *backend) (*dnsProxy, error) {
+	network := "udp"
+	if ap, err := netip.ParseAddrPort(addr); err == nil && ap.Addr().Is4() {
+		network = "udp4"
+	}
+	pc, err := net.ListenPacket(network, addr)
+	if err != nil {
+		return nil, err
+	}
+	p := &dnsProxy{pc: pc, fixed: fixed}
+	log.Infof("DNS proxy listening on %s, NetBird's resolver first", addr)
+	go p.serve()
+	return p, nil
+}
+
+func (p *dnsProxy) Close() error {
+	p.closed.Store(true)
+	return p.pc.Close()
+}
+
+func (p *dnsProxy) serve() {
+	buf := make([]byte, 65535)
+	for {
+		n, from, err := p.pc.ReadFrom(buf)
+		if err != nil {
+			if !p.closed.Load() {
+				log.Errorf("DNS proxy: %v", err)
+			}
+			return
+		}
+		if n < 12 {
+			continue
+		}
+		q := make([]byte, n)
+		copy(q, buf[:n])
+		go func() {
+			if resp := p.resolve(q); resp != nil {
+				_, _ = p.pc.WriteTo(resp, from)
+			}
+		}()
+	}
+}
+
+// resolve answers one query for this proxy's engine, or the running one.
+func (p *dnsProxy) resolve(q []byte) []byte { return resolveQuery(p.fixed, q) }
+
+// When NetBird's resolver cannot reach its upstream — a match-all
+// nameserver group out of reach from this network — every public name waits
+// out its timeout before a fallback answers, and each new name a page needs
+// costs seconds. After one public name took resolverSlow and still got no
+// answer, public names go straight to the fallbacks for resolverPause; then
+// NetBird is tried again. NetBird's own names always ask it.
+const (
+	resolverSlow  = 2 * time.Second
+	resolverPause = 30 * time.Second
+)
+
+var resolverPausedUntil atomic.Int64 // Unix milliseconds
+
+func resolverPaused() bool { return time.Now().UnixMilli() < resolverPausedUntil.Load() }
+
+// resolveQuery answers one query: NetBird's resolver (a single-label name
+// first under its search domains), then the fallbacks, raced. fixed is the
+// engine to ask; nil asks whichever runs, waiting a moment for one that is
+// expected. A name of NetBird's own is never sent to a fallback: its
+// SERVFAIL or REFUSED is the answer. nil means nobody answered.
+func resolveQuery(fixed *backend, q []byte) []byte {
+	b := fixed
+	if b == nil {
+		b = waitBackend(context.Background(), backendWaitDNS)
+	}
+	name := questionName(q)
+	own := name != "" && ownName(name)
+	var nb []byte
+	if b != nil && (own || !resolverPaused()) {
+		if resp := resolveShort(b, q); resp != nil {
+			return resp
+		}
+		asked := time.Now()
+		var err error
+		nb, err = askNetBird(b, q)
+		if err == nil && !retryable(nb) {
+			return nb
+		}
+		if !own && time.Since(asked) >= resolverSlow {
+			resolverPausedUntil.Store(time.Now().Add(resolverPause).UnixMilli())
+			log.Infof("DNS proxy: NetBird's resolver is not answering (%s took %v); public names go to the fallbacks for %v",
+				name, time.Since(asked).Round(time.Millisecond), resolverPause)
+		}
+	}
+	if own {
+		if nb == nil {
+			nb = servfail(q)
+		}
+		return nb
+	}
+	if resp := askFallbacks(b, q); resp != nil {
+		return resp
+	}
+	// Nothing better: NetBird's own answer, SERVFAIL or REFUSED as it is.
+	return nb
+}
+
+// publicResolvers join the fallbacks while an exit node carries the default
+// route: they are reached through it, as the rest of the traffic is, when
+// the network's own resolvers may not be (a carrier's answers only its
+// subscribers).
+var publicResolvers = []string{"1.1.1.1:53", "8.8.8.8:53"}
+
+// askFallbacks races the fallbacks (dns_upstream, else the network's
+// resolvers). With an engine, each is dialed the way the proxy dials it —
+// through an exit node when one is in use, a LAN resolver directly — and
+// when that brings nothing behind an exit node, the fallbacks are tried
+// once more directly.
+func askFallbacks(b *backend, q []byte) []byte {
+	servers := fallbackServers()
+	if b == nil || b.dialer == nil {
+		return raceExchange(context.Background(), q, servers, dialUDPDirect)
+	}
+	exit := exitNodeInUse()
+	if exit {
+		servers = appendNew(servers, publicResolvers...)
+	}
+	viaEngine := func(ctx context.Context, server string) (net.Conn, error) {
+		return b.dialer.Dial(ctx, "udp", server)
+	}
+	if resp := raceExchange(context.Background(), q, servers, viaEngine); resp != nil || !exit {
+		return resp
+	}
+	return raceExchange(context.Background(), q, fallbackServers(), dialUDPDirect)
+}
+
+func appendNew(list []string, more ...string) []string {
+	out := append([]string(nil), list...)
+	for _, m := range more {
+		dup := false
+		for _, s := range out {
+			if s == m {
+				dup = true
+				break
+			}
+		}
+		if !dup {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+// exitNodeInUse: a peer carries the default route (its allowed IPs hold the
+// public internet).
+func exitNodeInUse() bool {
+	routes.Lock()
+	known := routes.dump != nil
+	routes.Unlock()
+	return known && overlayDestination(net.JoinHostPort(publicResolvers[0], "53"))
+}
+
+// retryable is a response someone else may answer: no handler for the name
+// (REFUSED) or no upstream reachable (SERVFAIL).
+func retryable(resp []byte) bool {
+	if len(resp) < 4 {
+		return true
+	}
+	rcode := resp[3] & 0x0f
+	return rcode == 2 || rcode == 5
+}
+
+func askNetBird(b *backend, q []byte) ([]byte, error) {
+	conn, err := b.tunNet.DialUDPAddrPort(netip.AddrPort{}, b.nbDNS)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	return exchange(conn, q)
+}
+
+func dialUDPDirect(ctx context.Context, server string) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, "udp", server)
+}
+
+// negativeGrace is how long a negative answer (NXDOMAIN, or no records)
+// waits for another server to answer better: a network that mixes an
+// internal resolver with a public one gets the internal name, not the
+// public "no" (as birdsocksd/dnsrace.go does for the daemon's own lookups).
+const negativeGrace = 250 * time.Millisecond
+
+// raceExchange sends q to every server at once and returns the first
+// positive answer; a negative one waits negativeGrace for a better one, a
+// failure (SERVFAIL, REFUSED) is kept only when nobody does better. One
+// server at a time, three seconds each, made a dead first server cost every
+// lookup three seconds. nil when no server answered within dnsTimeout.
+func raceExchange(ctx context.Context, q []byte, servers []string, dial func(context.Context, string) (net.Conn, error)) []byte {
+	if len(servers) == 0 {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, dnsTimeout)
+	defer cancel()
+	answers := make(chan []byte, len(servers))
+	for _, s := range servers {
+		go func(s string) {
+			conn, err := dial(ctx, s)
+			if err != nil {
+				answers <- nil
+				return
+			}
+			stop := context.AfterFunc(ctx, func() { _ = conn.Close() })
+			defer stop()
+			defer conn.Close()
+			resp, err := exchange(conn, q)
+			if err != nil {
+				resp = nil
+			}
+			answers <- resp
+		}(s)
+	}
+	var negative, failure []byte
+	var grace <-chan time.Time
+	for settled := 0; settled < len(servers); {
+		select {
+		case p := <-answers:
+			settled++
+			switch {
+			case p == nil:
+			case positiveAnswer(p):
+				return p
+			case p[3]&0x0f == 0 || p[3]&0x0f == 3:
+				if negative == nil {
+					negative = p
+					grace = time.After(negativeGrace)
+				}
+			default:
+				if failure == nil {
+					failure = p
+				}
+			}
+		case <-grace:
+			return negative
+		case <-ctx.Done():
+			settled = len(servers)
+		}
+	}
+	if negative != nil {
+		return negative
+	}
+	return failure
+}
+
+// positiveAnswer: NOERROR with at least one answer record.
+func positiveAnswer(p []byte) bool { return len(p) >= 12 && p[3]&0x0f == 0 && (p[6] != 0 || p[7] != 0) }
+
+// questionName is the name asked, lower case with its trailing dot; "" when
+// q is not a query with one question.
+func questionName(q []byte) string {
+	var p dnsmessage.Parser
+	if _, err := p.Start(q); err != nil {
+		return ""
+	}
+	qs, err := p.AllQuestions()
+	if err != nil || len(qs) != 1 {
+		return ""
+	}
+	return strings.ToLower(qs[0].Name.String())
+}
+
+// servfail is a SERVFAIL for q: its id, its question, no records.
+func servfail(q []byte) []byte {
+	var p dnsmessage.Parser
+	h, err := p.Start(q)
+	if err != nil {
+		return nil
+	}
+	qs, err := p.AllQuestions()
+	if err != nil {
+		return nil
+	}
+	msg := dnsmessage.Message{
+		Header: dnsmessage.Header{
+			ID: h.ID, Response: true, OpCode: h.OpCode,
+			RecursionDesired: h.RecursionDesired, RecursionAvailable: true,
+			RCode: dnsmessage.RCodeServerFailure,
+		},
+		Questions: qs,
+	}
+	out, err := msg.Pack()
+	if err != nil {
+		return nil
+	}
+	return out
+}
+
+// exchange sends q on conn and reads the response with q's id.
+func exchange(conn net.Conn, q []byte) ([]byte, error) {
+	_ = conn.SetDeadline(time.Now().Add(dnsTimeout))
+	if _, err := conn.Write(q); err != nil {
+		return nil, err
+	}
+	buf := make([]byte, 65535)
+	for {
+		n, err := conn.Read(buf)
+		if err != nil {
+			return nil, err
+		}
+		if n >= 12 && buf[0] == q[0] && buf[1] == q[1] {
+			return append([]byte(nil), buf[:n]...), nil
+		}
+	}
+}
+
+// resolveShort answers a single-label name from the first search domain
+// NetBird has it under, renamed back to the name asked; nil when it is not a
+// short name or no domain has it. The domains are asked at once — some are
+// forwarded upstream and take seconds to say no — and the earliest domain in
+// the list that answers wins, as a system resolver's search order would.
+func resolveShort(b *backend, q []byte) []byte {
+	var msg dnsmessage.Message
+	if err := msg.Unpack(q); err != nil || len(msg.Questions) != 1 {
+		return nil
+	}
+	asked := msg.Questions[0].Name
+	names := expansions(asked.String())
+	if len(names) == 0 {
+		return nil
+	}
+	type result struct {
+		i    int
+		resp []byte
+	}
+	results := make(chan result, len(names))
+	for i, full := range names {
+		go func(i int, full string) {
+			results <- result{i, askExpanded(b, msg, full, asked)}
+		}(i, full)
+	}
+	got := make([][]byte, len(names))
+	done := make([]bool, len(names))
+	for range names {
+		r := <-results
+		got[r.i], done[r.i] = r.resp, true
+		// The earliest domain decides as soon as it and everything before it have answered.
+		for i := range names {
+			if !done[i] {
+				break
+			}
+			if got[i] != nil {
+				log.Debugf("DNS proxy: %s found as %s", asked, names[i])
+				return got[i]
+			}
+		}
+	}
+	return nil
+}
+
+// askExpanded asks NetBird for full in place of the short name, and returns
+// a positive answer renamed back to asked; nil otherwise.
+func askExpanded(b *backend, msg dnsmessage.Message, full string, asked dnsmessage.Name) []byte {
+	name, err := dnsmessage.NewName(full + ".")
+	if err != nil {
+		return nil
+	}
+	msg.Questions = []dnsmessage.Question{{Name: name, Type: msg.Questions[0].Type, Class: msg.Questions[0].Class}}
+	expanded, err := msg.Pack()
+	if err != nil {
+		return nil
+	}
+	resp, err := askNetBird(b, expanded)
+	if err != nil {
+		return nil
+	}
+	var r dnsmessage.Message
+	if r.Unpack(resp) != nil || r.Header.RCode != dnsmessage.RCodeSuccess || len(r.Answers) == 0 {
+		return nil
+	}
+	for i := range r.Questions {
+		r.Questions[i].Name = asked
+	}
+	for i := range r.Answers {
+		if r.Answers[i].Header.Name == name {
+			r.Answers[i].Header.Name = asked
+		}
+	}
+	out, err := r.Pack()
+	if err != nil {
+		return nil
+	}
+	return out
+}
