@@ -0,0 +1,264 @@
+package netstack
+
+// dnsproxy.go — BirdSocks: a plain DNS server on the host side of the
+// daemon, for apps and ad-blockers that take a DNS address rather than a
+// proxy. A query goes to NetBird's own resolver first, through the netstack
+// (peer names, the account's zones and nameserver groups are only there);
+// what NetBird has no handler for (REFUSED) or cannot answer (SERVFAIL) goes
+// to the network's resolvers.
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/net/dns/dnsmessage"
+	"golang.zx2c4.com/wireguard/tun/netstack"
+)
+
+// EnvDNSProxyAddress is where the DNS proxy listens, host:port; unset, there
+// is none.
+const EnvDNSProxyAddress = "NB_DNS_PROXY_ADDRESS"
+
+// EnvDNSProxyUpstream, comma-separated host:port, replaces the network's
+// resolvers for what NetBird does not answer — another DNS proxy, say
+// TailSocks', so that every mesh name resolves the same whichever an
+// ad-blocker asks first.
+const EnvDNSProxyUpstream = "NB_DNS_PROXY_UPSTREAM"
+
+const dnsTimeout = 3 * time.Second
+
+var fallbackDNS struct {
+	sync.RWMutex
+	servers func() []string
+}
+
+// SetFallbackDNS supplies the network's resolvers ("ip:port" each), asked for
+// what NetBird does not answer. The daemon's entry point owns them.
+func SetFallbackDNS(f func() []string) {
+	fallbackDNS.Lock()
+	fallbackDNS.servers = f
+	fallbackDNS.Unlock()
+}
+
+func fallbackServers() []string {
+	if v := os.Getenv(EnvDNSProxyUpstream); v != "" {
+		var out []string
+		for _, s := range strings.Split(v, ",") {
+			if s = strings.TrimSpace(s); s != "" {
+				if _, _, err := net.SplitHostPort(s); err != nil {
+					s = net.JoinHostPort(s, "53")
+				}
+				out = append(out, s)
+			}
+		}
+		if len(out) > 0 {
+			return out
+		}
+	}
+	fallbackDNS.RLock()
+	defer fallbackDNS.RUnlock()
+	if fallbackDNS.servers == nil {
+		return []string{"8.8.8.8:53", "1.1.1.1:53"}
+	}
+	return fallbackDNS.servers()
+}
+
+type dnsProxy struct {
+	pc     net.PacketConn
+	tunNet *netstack.Net
+	nbDNS  netip.AddrPort
+	closed atomic.Bool
+}
+
+func startDNSProxy(addr string, tunNet *netstack.Net, dnsAddr netip.Addr) (*dnsProxy, error) {
+	network := "udp"
+	if ap, err := netip.ParseAddrPort(addr); err == nil && ap.Addr().Is4() {
+		network = "udp4"
+	}
+	pc, err := net.ListenPacket(network, addr)
+	if err != nil {
+		return nil, err
+	}
+	p := &dnsProxy{pc: pc, tunNet: tunNet, nbDNS: netip.AddrPortFrom(dnsAddr, 53)}
+	log.Infof("DNS proxy listening on %s, NetBird's resolver %s first", addr, p.nbDNS)
+	go p.serve()
+	return p, nil
+}
+
+func (p *dnsProxy) Close() error {
+	p.closed.Store(true)
+	return p.pc.Close()
+}
+
+func (p *dnsProxy) serve() {
+	buf := make([]byte, 65535)
+	for {
+		n, from, err := p.pc.ReadFrom(buf)
+		if err != nil {
+			if !p.closed.Load() {
+				log.Errorf("DNS proxy: %v", err)
+			}
+			return
+		}
+		if n < 12 {
+			continue
+		}
+		q := make([]byte, n)
+		copy(q, buf[:n])
+		go func() {
+			if resp := p.resolve(q); resp != nil {
+				_, _ = p.pc.WriteTo(resp, from)
+			}
+		}()
+	}
+}
+
+// resolve answers one query: NetBird's resolver, then the network's. A
+// single-label name is first tried under NetBird's search domains.
+func (p *dnsProxy) resolve(q []byte) []byte {
+	if resp := p.resolveShort(q); resp != nil {
+		return resp
+	}
+	nb, err := p.askNetBird(q)
+	if err == nil && !retryable(nb) {
+		return nb
+	}
+	for _, s := range fallbackServers() {
+		if resp, err := askUDP(q, s); err == nil {
+			return resp
+		}
+	}
+	// Nothing better: NetBird's own answer, SERVFAIL or REFUSED as it is.
+	return nb
+}
+
+// retryable is a response someone else may answer: no handler for the name
+// (REFUSED) or no upstream reachable (SERVFAIL).
+func retryable(resp []byte) bool {
+	if len(resp) < 4 {
+		return true
+	}
+	rcode := resp[3] & 0x0f
+	return rcode == 2 || rcode == 5
+}
+
+func (p *dnsProxy) askNetBird(q []byte) ([]byte, error) {
+	conn, err := p.tunNet.DialUDPAddrPort(netip.AddrPort{}, p.nbDNS)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	return exchange(conn, q)
+}
+
+func askUDP(q []byte, server string) ([]byte, error) {
+	conn, err := net.DialTimeout("udp", server, dnsTimeout)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	return exchange(conn, q)
+}
+
+// exchange sends q on conn and reads the response with q's id.
+func exchange(conn net.Conn, q []byte) ([]byte, error) {
+	_ = conn.SetDeadline(time.Now().Add(dnsTimeout))
+	if _, err := conn.Write(q); err != nil {
+		return nil, err
+	}
+	buf := make([]byte, 65535)
+	for {
+		n, err := conn.Read(buf)
+		if err != nil {
+			return nil, err
+		}
+		if n >= 12 && buf[0] == q[0] && buf[1] == q[1] {
+			return append([]byte(nil), buf[:n]...), nil
+		}
+	}
+}
+
+// resolveShort answers a single-label name from the first search domain
+// NetBird has it under, renamed back to the name asked; nil when it is not a
+// short name or no domain has it. The domains are asked at once — some are
+// forwarded upstream and take seconds to say no — and the earliest domain in
+// the list that answers wins, as a system resolver's search order would.
+func (p *dnsProxy) resolveShort(q []byte) []byte {
+	var msg dnsmessage.Message
+	if err := msg.Unpack(q); err != nil || len(msg.Questions) != 1 {
+		return nil
+	}
+	asked := msg.Questions[0].Name
+	names := expansions(asked.String())
+	if len(names) == 0 {
+		return nil
+	}
+	type result struct {
+		i    int
+		resp []byte
+	}
+	results := make(chan result, len(names))
+	for i, full := range names {
+		go func(i int, full string) {
+			results <- result{i, p.askExpanded(msg, full, asked)}
+		}(i, full)
+	}
+	got := make([][]byte, len(names))
+	done := make([]bool, len(names))
+	for range names {
+		r := <-results
+		got[r.i], done[r.i] = r.resp, true
+		// The earliest domain decides as soon as it and everything before it have answered.
+		for i := range names {
+			if !done[i] {
+				break
+			}
+			if got[i] != nil {
+				log.Debugf("DNS proxy: %s found as %s", asked, names[i])
+				return got[i]
+			}
+		}
+	}
+	return nil
+}
+
+// askExpanded asks NetBird for full in place of the short name, and returns
+// a positive answer renamed back to asked; nil otherwise.
+func (p *dnsProxy) askExpanded(msg dnsmessage.Message, full string, asked dnsmessage.Name) []byte {
+	name, err := dnsmessage.NewName(full + ".")
+	if err != nil {
+		return nil
+	}
+	msg.Questions = []dnsmessage.Question{{Name: name, Type: msg.Questions[0].Type, Class: msg.Questions[0].Class}}
+	expanded, err := msg.Pack()
+	if err != nil {
+		return nil
+	}
+	resp, err := p.askNetBird(expanded)
+	if err != nil {
+		return nil
+	}
+	var r dnsmessage.Message
+	if r.Unpack(resp) != nil || r.Header.RCode != dnsmessage.RCodeSuccess || len(r.Answers) == 0 {
+		return nil
+	}
+	for i := range r.Questions {
+		r.Questions[i].Name = asked
+	}
+	for i := range r.Answers {
+		if r.Answers[i].Header.Name == name {
+			r.Answers[i].Header.Name = asked
+		}
+	}
+	out, err := r.Pack()
+	if err != nil {
+		return nil
+	}
+	return out
+}
--- netbird_orig/client/iface/netstack/associate.go
+++ netbird_src/client/iface/netstack/associate.go
@@ -0,0 +1,156 @@
+package netstack
+
+// associate.go — BirdSocks: SOCKS5 UDP ASSOCIATE. go-socks5's own handler
+// relays from a socket bound to every interface and, when the client
+// declares no address (most send 0.0.0.0:0), accepts datagrams from anyone
+// who finds the port: an open UDP relay on the LAN, past the password. This
+// one binds the relay to the address the client reached the proxy on,
+// accepts only the client's IP, sends through the proxy's dialer (names
+// resolved the way CONNECT resolves them) and drops idle destinations.
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/things-go/go-socks5"
+	"github.com/things-go/go-socks5/statute"
+
+	log "github.com/sirupsen/logrus"
+)
+
+const udpIdleTimeout = 2 * time.Minute
+
+func associateHandler(dialer Dialer) func(ctx context.Context, w io.Writer, req *socks5.Request) error {
+	return func(ctx context.Context, w io.Writer, req *socks5.Request) error {
+		local, _ := req.LocalAddr.(*net.TCPAddr)
+		client, _ := req.RemoteAddr.(*net.TCPAddr)
+		if local == nil || client == nil {
+			_ = socks5.SendReply(w, statute.RepServerFailure, nil)
+			return errors.New("associate: no TCP addresses")
+		}
+		relay, err := net.ListenUDP("udp", &net.UDPAddr{IP: local.IP})
+		if err != nil {
+			_ = socks5.SendReply(w, statute.RepServerFailure, nil)
+			return err
+		}
+		if err := socks5.SendReply(w, statute.RepSuccess, relay.LocalAddr()); err != nil {
+			relay.Close()
+			return err
+		}
+
+		ctx, cancel := context.WithCancel(ctx)
+		defer cancel()
+		go relayDatagrams(ctx, relay, client.IP, req.DestAddr, dialer)
+
+		// The association lives as long as its TCP connection.
+		buf := make([]byte, 512)
+		for {
+			if _, err := req.Reader.Read(buf); err != nil {
+				relay.Close()
+				if errors.Is(err, io.EOF) || errors.Is(err, net.ErrClosed) {
+					return nil
+				}
+				return err
+			}
+		}
+	}
+}
+
+type udpTarget struct {
+	conn net.Conn
+	last time.Time
+}
+
+func relayDatagrams(ctx context.Context, relay *net.UDPConn, clientIP net.IP, declared *statute.AddrSpec, dialer Dialer) {
+	var mu sync.Mutex
+	targets := map[string]*udpTarget{}
+	defer func() {
+		mu.Lock()
+		for _, t := range targets {
+			t.conn.Close()
+		}
+		mu.Unlock()
+	}()
+
+	go func() {
+		tick := time.NewTicker(30 * time.Second)
+		defer tick.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-tick.C:
+				mu.Lock()
+				for k, t := range targets {
+					if time.Since(t.last) > udpIdleTimeout {
+						t.conn.Close()
+						delete(targets, k)
+					}
+				}
+				mu.Unlock()
+			}
+		}
+	}()
+
+	buf := make([]byte, 65535)
+	for {
+		n, src, err := relay.ReadFromUDP(buf)
+		if err != nil {
+			return
+		}
+		if !src.IP.Equal(clientIP) {
+			continue
+		}
+		if declared != nil && declared.Port != 0 && declared.Port != src.Port {
+			continue
+		}
+		pk, err := statute.ParseDatagram(buf[:n])
+		if err != nil || pk.Frag != 0 {
+			continue
+		}
+		key := src.String() + "|" + pk.DstAddr.String()
+
+		mu.Lock()
+		t, ok := targets[key]
+		mu.Unlock()
+		if !ok {
+			conn, err := dialer.Dial(ctx, "udp", pk.DstAddr.String())
+			if err != nil {
+				log.Debugf("socks5 udp: %s: %v", pk.DstAddr.String(), err)
+				continue
+			}
+			t = &udpTarget{conn: conn, last: time.Now()}
+			mu.Lock()
+			targets[key] = t
+			mu.Unlock()
+			header := pk.Header()
+			go func(conn net.Conn, to *net.UDPAddr) {
+				rb := make([]byte, 65535)
+				for {
+					m, err := conn.Read(rb)
+					if err != nil {
+						return
+					}
+					mu.Lock()
+					t.last = time.Now()
+					mu.Unlock()
+					out := make([]byte, 0, len(header)+m)
+					out = append(append(out, header...), rb[:m]...)
+					if _, err := relay.WriteToUDP(out, to); err != nil {
+						return
+					}
+				}
+			}(conn, src)
+		}
+		mu.Lock()
+		t.last = time.Now()
+		mu.Unlock()
+		if _, err := t.conn.Write(pk.Data); err != nil {
+			log.Debugf("socks5 udp: write %s: %v", pk.DstAddr.String(), err)
+		}
+	}
+}
--- netbird_orig/client/iface/netstack/associate_test.go
+++ netbird_src/client/iface/netstack/associate_test.go
@@ -0,0 +1,110 @@
+package netstack
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/things-go/go-socks5"
+	"github.com/things-go/go-socks5/statute"
+)
+
+type hostDialer struct{}
+
+func (hostDialer) Dial(ctx context.Context, network, addr string) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, network, addr)
+}
+
+// A datagram through the association reaches a UDP echo server and comes
+// back framed; the relay is bound to the address the client used.
+func TestAssociateRelaysAndBindsToClientAddress(t *testing.T) {
+	echo, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echo.Close()
+	go func() {
+		b := make([]byte, 1500)
+		for {
+			n, a, err := echo.ReadFromUDP(b)
+			if err != nil {
+				return
+			}
+			_, _ = echo.WriteToUDP(b[:n], a)
+		}
+	}()
+
+	srv := socks5.NewServer(socks5.WithDial(hostDialer{}.Dial), socks5.WithAssociateHandle(associateHandler(hostDialer{})))
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() { _ = srv.Serve(ln) }()
+
+	ctrl, err := net.Dial("tcp4", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ctrl.Close()
+	_ = ctrl.SetDeadline(time.Now().Add(5 * time.Second))
+	// Greeting: no auth.
+	if _, err := ctrl.Write([]byte{5, 1, 0}); err != nil {
+		t.Fatal(err)
+	}
+	if b := readN(t, ctrl, 2); !bytes.Equal(b, []byte{5, 0}) {
+		t.Fatalf("greeting reply %v", b)
+	}
+	// UDP ASSOCIATE, declared address 0.0.0.0:0.
+	if _, err := ctrl.Write([]byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0}); err != nil {
+		t.Fatal(err)
+	}
+	rep := readN(t, ctrl, 10)
+	if rep[1] != 0 {
+		t.Fatalf("associate refused: %v", rep)
+	}
+	relayIP := net.IP(rep[4:8])
+	relayPort := int(rep[8])<<8 | int(rep[9])
+	if !relayIP.Equal(net.IPv4(127, 0, 0, 1)) {
+		t.Fatalf("relay bound to %v, want the client's 127.0.0.1", relayIP)
+	}
+
+	u, err := net.DialUDP("udp4", nil, &net.UDPAddr{IP: relayIP, Port: relayPort})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer u.Close()
+	dg, err := statute.NewDatagram(echo.LocalAddr().String(), []byte("ping"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := u.Write(dg.Bytes()); err != nil {
+		t.Fatal(err)
+	}
+	_ = u.SetReadDeadline(time.Now().Add(3 * time.Second))
+	b := make([]byte, 1500)
+	n, err := u.Read(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, err := statute.ParseDatagram(b[:n])
+	if err != nil || string(back.Data) != "ping" {
+		t.Fatalf("got %q, %v", back.Data, err)
+	}
+}
+
+func readN(t *testing.T, c net.Conn, n int) []byte {
+	t.Helper()
+	b := make([]byte, n)
+	for got := 0; got < n; {
+		m, err := c.Read(b[got:])
+		if err != nil {
+			t.Fatal(err)
+		}
+		got += m
+	}
+	return b
+}
--- netbird_orig/client/iface/netstack/searchdomains.go
+++ netbird_src/client/iface/netstack/searchdomains.go
@@ -0,0 +1,56 @@
+package netstack
+
+// searchdomains.go — BirdSocks: short names. A desktop client hands NetBird's
+// search domains to the system resolver, so "sleeperpc" finds
+// sleeperpc.<domain>; in netstack mode there is no system resolver to hand
+// them to, and the proxies resolve names themselves. The engine supplies the
+// list here, and both proxies try a single-label name under each domain.
+
+import (
+	"strings"
+	"sync"
+)
+
+var searchDomains struct {
+	sync.RWMutex
+	source func() []string
+}
+
+// SetSearchDomains supplies NetBird's current search domains; the engine
+// calls it once its DNS server exists.
+func SetSearchDomains(source func() []string) {
+	searchDomains.Lock()
+	searchDomains.source = source
+	searchDomains.Unlock()
+}
+
+func currentSearchDomains() []string {
+	searchDomains.RLock()
+	defer searchDomains.RUnlock()
+	if searchDomains.source == nil {
+		return nil
+	}
+	return searchDomains.source()
+}
+
+// singleLabel reports whether name, with or without its trailing dot, has no
+// dot of its own: the names search domains apply to.
+func singleLabel(name string) bool {
+	n := strings.TrimSuffix(name, ".")
+	return n != "" && !strings.Contains(n, ".")
+}
+
+// expansions are the names to try for a single-label name, in order.
+func expansions(name string) []string {
+	if !singleLabel(name) || strings.EqualFold(strings.TrimSuffix(name, "."), "localhost") {
+		return nil
+	}
+	n := strings.TrimSuffix(name, ".")
+	var out []string
+	for _, d := range currentSearchDomains() {
+		if d = strings.Trim(d, "."); d != "" {
+			out = append(out, n+"."+d)
+		}
+	}
+	return out
+}
