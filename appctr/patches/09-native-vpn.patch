+	require.Empty(t, reply.Error)
+	require.True(t, VPNAttached())
+
+	query := append([]byte{0x12, 0x34}, make([]byte, 10)...)
+	pkt := ipv4Packet(t, protoUDP, netip.AddrPortFrom(vpnSelf, 35000), netip.MustParseAddrPort("198.18.0.2:53"), 0, query)
+	_, err = android.Write(pkt)
