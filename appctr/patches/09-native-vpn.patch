+// fakeKernel attaches one end of a SEQPACKET pair as the VPN interface,
+// with no forwarder, and returns the other end: Android's side.
+func fakeKernel(t *testing.T) *os.File {
+	t.Helper()
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	require.NoError(t, err)
+	require.NoError(t, unix.SetNonblock(fds[0], true))
+	require.NoError(t, unix.SetNonblock(fds[1], true))
+	k := &kernelTun{f: os.NewFile(uintptr(fds[0]), "vpn")}
+	vpnKernel.Store(k)
+	t.Cleanup(func() {
+		vpnKernel.CompareAndSwap(k, nil)
+		k.closed.Store(true)
+		_ = k.f.Close()
+	})
+	android := os.NewFile(uintptr(fds[1]), "android")
+	t.Cleanup(func() { _ = android.Close() })
+	return android
+}
+
+func readPacket(t *testing.T, f *os.File, wait time.Duration) []byte {
+	t.Helper()
+	require.NoError(t, f.SetReadDeadline(time.Now().Add(wait)))
+	buf := make([]byte, 65535)
+	n, err := f.Read(buf)
+	if err != nil {
+		return nil
+	}
+	return buf[:n]
+}
+
+func recvNS(ns *fakeNS, wait time.Duration) []byte {
+	select {
+	case p := <-ns.got:
+		return p
+	case <-time.After(wait):
+		return nil
+	}
+}
