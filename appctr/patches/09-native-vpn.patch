+func TestFlowTableForgets(t *testing.T) {
+	var ft flowTable
+	k := flowKey{proto: protoTCP, local: 1, remote: netip.AddrPortFrom(vpnPeer, 2)}
+	ft.touch(k, time.Hour)
+	assert.True(t, ft.has(k))
+	ft.noteTCP(k, tcpFlagFIN)
+	assert.True(t, ft.has(k), "a closing connection lingers")
+	ft.noteTCP(k, tcpFlagRST)
+	assert.False(t, ft.has(k), "a reset one is gone")
+	ft.touch(k, -time.Second)
+	assert.False(t, ft.has(k), "an expired one is gone")
+}
