+func vpnCall(t *testing.T, sock string, req vpnRequest, fd int) vpnReply {
+	t.Helper()
+	c, err := net.DialUnix("unixpacket", nil, &net.UnixAddr{Name: sock, Net: "unixpacket"})
+	require.NoError(t, err)
+	defer c.Close()
+	b, err := json.Marshal(req)
+	require.NoError(t, err)
+	var oob []byte
+	if fd >= 0 {
+		oob = syscall.UnixRights(fd)
+	}
+	_, _, err = c.WriteMsgUnix(b, oob, nil)
+	require.NoError(t, err)
+	if fd >= 0 {
+		_ = syscall.Close(fd)
+	}
+	require.NoError(t, c.SetReadDeadline(time.Now().Add(5*time.Second)))
+	buf := make([]byte, 4096)
+	n, err := c.Read(buf)
+	require.NoError(t, err)
+	var r vpnReply
+	require.NoError(t, json.Unmarshal(buf[:n], &r))
+	return r
+}
