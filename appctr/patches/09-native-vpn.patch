+func setInbound(t *testing.T, on bool, own ...uint16) {
+	t.Helper()
+	prevIn, prevPorts := vpnInbound, vpnOwnPorts
+	ports := map[uint16]bool{}
+	for _, p := range own {
+		ports[p] = true
+	}
+	vpnInbound = func() bool { return on }
+	vpnOwnPorts = func() map[uint16]bool { return ports }
+	t.Cleanup(func() { vpnInbound, vpnOwnPorts = prevIn, prevPorts })
+}
