+func TestParsePacket(t *testing.T) {
+	p := ipv4Packet(t, protoTCP, netip.AddrPortFrom(vpnPeer, 40000), netip.AddrPortFrom(vpnSelf, 1716), tcpFlagSYN, nil)
+	pi, ok := parsePacket(p)
+	require.True(t, ok)
+	assert.Equal(t, vpnPeer, pi.src)
+	assert.Equal(t, vpnSelf, pi.dst)
+	assert.Equal(t, uint8(protoTCP), pi.proto)
+	assert.Equal(t, uint16(40000), pi.srcPort)
+	assert.Equal(t, uint16(1716), pi.dstPort)
+	assert.Equal(t, uint8(tcpFlagSYN), pi.tcpFlags)
+	assert.True(t, pi.ports)
+
+	// A later fragment carries no ports.
+	binary.BigEndian.PutUint16(p[6:8], 100)
+	pi, ok = parsePacket(p)
+	require.True(t, ok)
+	assert.False(t, pi.ports, "fragment offset 100 has no transport header")
+
+	_, ok = parsePacket([]byte{0x45, 0})
+	assert.False(t, ok, "a cut header is not a packet")
+
+	v6 := make([]byte, 48)
+	v6[0] = 0x60
+	v6[6] = protoUDP
+	copy(v6[8:24], netip.MustParseAddr("fd00::1").AsSlice())
+	copy(v6[24:40], netip.MustParseAddr("fd00::2").AsSlice())
+	binary.BigEndian.PutUint16(v6[40:42], 53)
+	binary.BigEndian.PutUint16(v6[42:44], 5353)
+	pi, ok = parsePacket(v6)
+	require.True(t, ok)
+	assert.Equal(t, netip.MustParseAddr("fd00::2"), pi.dst)
+	assert.Equal(t, uint16(5353), pi.dstPort)
+}
