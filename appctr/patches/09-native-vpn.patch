+// ipv4Packet builds an IPv4 packet with a TCP or UDP header and valid
+// checksums.
+func ipv4Packet(t *testing.T, proto uint8, src, dst netip.AddrPort, flags uint8, payload []byte) []byte {
+	t.Helper()
+	var l4 []byte
+	switch proto {
+	case protoTCP:
+		l4 = make([]byte, header.TCPMinimumSize+len(payload))
+		tcp := header.TCP(l4)
+		tcp.Encode(&header.TCPFields{
+			SrcPort:    src.Port(),
+			DstPort:    dst.Port(),
+			SeqNum:     1000,
+			DataOffset: header.TCPMinimumSize,
+			Flags:      header.TCPFlags(flags),
+			WindowSize: 65535,
+		})
+		copy(l4[header.TCPMinimumSize:], payload)
+	case protoUDP:
+		l4 = make([]byte, header.UDPMinimumSize+len(payload))
+		udp := header.UDP(l4)
+		udp.Encode(&header.UDPFields{SrcPort: src.Port(), DstPort: dst.Port(), Length: uint16(len(l4))})
+		copy(l4[header.UDPMinimumSize:], payload)
+	case protoICMP:
+		l4 = make([]byte, 8)
+		l4[0] = 8 // echo request
+	}
+	p := make([]byte, header.IPv4MinimumSize+len(l4))
+	ip := header.IPv4(p)
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: uint16(len(p)),
+		TTL:         64,
+		Protocol:    proto,
+		SrcAddr:     tcpip.AddrFrom4(src.Addr().As4()),
+		DstAddr:     tcpip.AddrFrom4(dst.Addr().As4()),
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	copy(p[header.IPv4MinimumSize:], l4)
+	srcA, dstA := tcpip.AddrFrom4(src.Addr().As4()), tcpip.AddrFrom4(dst.Addr().As4())
+	switch proto {
+	case protoTCP:
+		tcp := header.TCP(p[header.IPv4MinimumSize:])
+		xsum := header.PseudoHeaderChecksum(header.TCPProtocolNumber, srcA, dstA, uint16(len(l4)))
+		xsum = checksum.Checksum(payload, xsum)
+		tcp.SetChecksum(^tcp.CalculateChecksum(xsum))
+	case protoUDP:
+		udp := header.UDP(p[header.IPv4MinimumSize:])
+		xsum := header.PseudoHeaderChecksum(header.UDPProtocolNumber, srcA, dstA, uint16(len(l4)))
+		xsum = checksum.Checksum(payload, xsum)
+		udp.SetChecksum(^udp.CalculateChecksum(xsum))
+	}
+	return p
+}
