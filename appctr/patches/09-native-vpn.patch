+func TestSplitRoutesPeersToAndroid(t *testing.T) {
+	android := fakeKernel(t)
+	setInbound(t, true, 48125)
+	ns := newFakeNS()
+	s := newSplitTUN(ns, []netip.Addr{vpnSelf})
+	defer s.Close()
+	peer := func(port uint16) netip.AddrPort { return netip.AddrPortFrom(vpnPeer, port) }
+	self := func(port uint16) netip.AddrPort { return netip.AddrPortFrom(vpnSelf, port) }
+
+	// The netstack opens a connection; the peer's answer goes back to it.
+	ns.out <- ipv4Packet(t, protoTCP, self(41000), peer(443), tcpFlagSYN, nil)
+	bufs, sizes := [][]byte{make([]byte, 2000)}, []int{0}
+	_, err := s.Read(bufs, sizes, 0)
+	require.NoError(t, err)
+	synAck := ipv4Packet(t, protoTCP, peer(443), self(41000), tcpFlagSYN|tcpFlagACK, nil)
+	_, err = s.Write([][]byte{synAck}, 0)
+	require.NoError(t, err)
+	assert.Equal(t, synAck, recvNS(ns, time.Second), "an answer to the netstack's connection goes to the netstack")
+
+	// A peer opens a connection to an app: Android gets it, with the peer's address.
+	syn := ipv4Packet(t, protoTCP, peer(50000), self(1716), tcpFlagSYN, nil)
+	_, err = s.Write([][]byte{syn}, 0)
+	require.NoError(t, err)
+	assert.Equal(t, syn, readPacket(t, android, time.Second), "a new connection from a peer reaches Android's apps")
+
+	// A datagram to an app (KDE Connect's discovery) too.
+	hello := ipv4Packet(t, protoUDP, peer(1716), self(1716), 0, []byte(`{"type":"kdeconnect.identity"}`))
+	_, err = s.Write([][]byte{hello}, 0)
+	require.NoError(t, err)
+	assert.Equal(t, hello, readPacket(t, android, time.Second), "a peer's datagram reaches Android's apps")
+
+	// Never the app's own proxy.
+	toProxy := ipv4Packet(t, protoTCP, peer(50001), self(48125), tcpFlagSYN, nil)
+	_, err = s.Write([][]byte{toProxy}, 0)
+	require.NoError(t, err)
+	assert.Nil(t, readPacket(t, android, 200*time.Millisecond), "the SOCKS5 port stays closed to peers")
+	assert.Nil(t, recvNS(ns, 50*time.Millisecond), "and the netstack does not get it either")
+}
