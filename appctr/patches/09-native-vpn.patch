--- netbird_orig/client/iface/netstack/vpn.go
+++ netbird_src/client/iface/netstack/vpn.go
@@ -0,0 +1,411 @@
+//go:build linux
+
+package netstack
+
+// vpn.go — BirdSocks: Android's VPN interface, attached to the netstack
+// daemon. The app establishes the interface on the device's NetBird address
+// and hands its descriptor over a unix socket (ServeVPN); no daemon restart,
+// and a new descriptor when the routes change. What apps send through it:
+//
+//   - to a destination a peer carries (vpn_split.go) goes to WireGuard as it
+//     is, with the device's own address;
+//   - to anything else — the VPN's resolver (tundns.go), the local network
+//     behind an exit node, the internet under a domain route — is ended in a
+//     forwarder and dialed again from the daemon, which the VPN leaves out.
+//
+// Packets from peers to the device reach Android's apps through it with
+// the peer's address, which the netstack's forwarding to 127.0.0.1 cannot
+// give them.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+	"golang.zx2c4.com/wireguard/tun"
+
+	"github.com/netbirdio/netbird/client/iface/wgaddr"
+)
+
+const (
+	// envLocalForwarding is what the app sets when peers may reach the
+	// device's own services (Access to the phone).
+	envLocalForwarding = "NB_ENABLE_NETSTACK_LOCAL_FORWARDING"
+	// envNoForwardPorts: the app's own listeners, which peers never reach.
+	envNoForwardPorts = "NB_BIRDSOCKS_NO_FORWARD_PORTS"
+
+	vpnRequestMax = 4096
+	vpnConnWait   = 10 * time.Second
+)
+
+// PacketWriter takes packets back toward the apps behind the VPN.
+type PacketWriter interface {
+	CreateOutboundPacket(packet []byte, dst net.IP) error
+}
+
+// DialFunc reaches a destination of the direct path.
+type DialFunc = func(ctx context.Context, network, address string) (net.Conn, error)
+
+// DirectEgress ends what apps send to destinations no peer carries.
+type DirectEgress interface {
+	InjectIncomingPacket(packet []byte) error
+	Stop()
+}
+
+// DirectEgressFactory builds the direct path of a VPN interface: uspfilter's
+// forwarder, which the daemon passes in — this package cannot import it,
+// since client/net imports this one.
+type DirectEgressFactory func(addr wgaddr.Address, out PacketWriter, dial DialFunc, mtu uint16) (DirectEgress, error)
+
+var (
+	// vpnServing: the daemon takes a VPN interface, so engines wrap their device.
+	vpnServing atomic.Bool
+	vpnDirect  DirectEgressFactory
+	vpnKernel  atomic.Pointer[kernelTun]
+	vpnSplit   atomic.Pointer[splitTUN]
+)
+
+// VPNAttached reports whether the app's VPN interface carries the device's
+// traffic: packets for the device then go to Android's stack through it.
+func VPNAttached() bool { return vpnKernel.Load() != nil }
+
+func attachedKernel() *kernelTun { return vpnKernel.Load() }
+
+// WrapForVPN is the engine's netstack device, made able to share the
+// device with the VPN when the daemon serves one; dev itself otherwise.
+func WrapForVPN(dev tun.Device, local []netip.Addr) tun.Device {
+	if !vpnServing.Load() {
+		return dev
+	}
+	s := newSplitTUN(dev, local)
+	vpnSplit.Store(s)
+	return s
+}
+
+func releaseSplit(s *splitTUN) { vpnSplit.CompareAndSwap(s, nil) }
+
+var vpnInbound = sync.OnceValue(func() bool {
+	v, _ := strconv.ParseBool(os.Getenv(envLocalForwarding))
+	return v
+})
+
+var vpnOwnPorts = sync.OnceValue(func() map[uint16]bool {
+	ports := map[uint16]bool{}
+	for _, s := range strings.Split(os.Getenv(envNoForwardPorts), ",") {
+		if p, err := strconv.ParseUint(strings.TrimSpace(s), 10, 16); err == nil && p != 0 {
+			ports[uint16(p)] = true
+		}
+	}
+	return ports
+})
+
+// inboundAllowed: a peer may open a connection to this port of the device.
+func inboundAllowed(port uint16) bool { return vpnInbound() && !vpnOwnPorts()[port] }
+
+// inOverlayNetwork: an address in the NetBird network itself.
+func inOverlayNetwork(ip netip.Addr) bool {
+	routes.Lock()
+	defer routes.Unlock()
+	for _, p := range routes.overlay {
+		if p.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+// kernelTun is the VPN interface the app handed over.
+type kernelTun struct {
+	f      *os.File
+	addrs  []netip.Addr
+	direct DirectEgress
+	closed atomic.Bool
+}
+
+func (k *kernelTun) write(p []byte) {
+	if _, err := k.f.Write(p); err != nil && !k.closed.Load() {
+		log.Debugf("VPN interface write: %v", err)
+	}
+}
+
+// CreateOutboundPacket takes the direct forwarder's answers to the apps.
+func (k *kernelTun) CreateOutboundPacket(packet []byte, _ net.IP) error {
+	// After a detach the forwarder's connections still answer for a moment;
+	// there is nobody to answer to, and that is not an error.
+	if k.closed.Load() {
+		return nil
+	}
+	_, err := k.f.Write(packet)
+	if err != nil && k.closed.Load() {
+		return nil
+	}
+	return err
+}
+
+func (k *kernelTun) readLoop() {
+	buf := make([]byte, 65535)
+	for {
+		n, err := k.f.Read(buf)
+		if err != nil {
+			if !k.closed.Load() {
+				log.Warnf("VPN interface: %v", err)
+				if vpnKernel.CompareAndSwap(k, nil) {
+					k.stop()
+				}
+			}
+			return
+		}
+		if n > 0 {
+			k.route(append([]byte(nil), buf[:n]...))
+		}
+	}
+}
+
+// route sends a packet an app wrote to WireGuard, or ends it here.
+func (k *kernelTun) route(p []byte) {
+	pi, ok := parsePacket(p)
+	if !ok {
+		return
+	}
+	dst := pi.dst.Unmap()
+	if dns, ok := tunDNSAddress(); ok && dst == dns {
+		k.inject(p)
+		return
+	}
+	if s := vpnSplit.Load(); s != nil && overlayAddr(dst) {
+		s.fromKernel(p, pi)
+		return
+	}
+	if inOverlayNetwork(dst) {
+		// No engine: no peer to give it to, and never the internet.
+		return
+	}
+	k.inject(p)
+}
+
+func (k *kernelTun) inject(p []byte) {
+	if err := k.direct.InjectIncomingPacket(p); err != nil {
+		log.Tracef("VPN direct: %v", err)
+	}
+}
+
+func (k *kernelTun) stop() {
+	k.closed.Store(true)
+	_ = k.f.Close()
+	k.direct.Stop()
+}
+
+// vpnDial reaches what the forwarder ends: the VPN's resolver in memory,
+// anything else from the daemon over the device's network.
+func vpnDial(ctx context.Context, network, addr string) (net.Conn, error) {
+	if conn, handled, err := tunDNSDial(network, addr); handled {
+		return conn, err
+	}
+	return dialDirect(ctx, network, addr)
+}
+
+// attachVPN makes f the VPN interface, replacing the one before.
+func attachVPN(f *os.File, mtu int, addrs []netip.Addr) error {
+	var addr wgaddr.Address
+	for _, a := range addrs {
+		switch {
+		case a.Is4() && !addr.IP.IsValid():
+			addr.IP, addr.Network = a, netip.PrefixFrom(a, 32)
+		case a.Is6() && !addr.IPv6.IsValid():
+			addr.IPv6, addr.IPv6Net = a, netip.PrefixFrom(a, 128)
+		}
+	}
+	if !addr.IP.IsValid() {
+		return errors.New("the VPN interface needs an IPv4 address")
+	}
+	if mtu < 576 || mtu > 65535 {
+		return fmt.Errorf("MTU %d", mtu)
+	}
+	k := &kernelTun{f: f, addrs: addrs}
+	direct, err := vpnDirect(addr, k, vpnDial, uint16(mtu))
+	if err != nil {
+		return fmt.Errorf("forwarder: %w", err)
+	}
+	k.direct = direct
+	old := vpnKernel.Swap(k)
+	go k.readLoop()
+	if old != nil {
+		old.stop()
+	}
+	log.Infof("VPN interface attached: %v, MTU %d", addrs, mtu)
+	return nil
+}
+
+func detachVPN() {
+	if old := vpnKernel.Swap(nil); old != nil {
+		old.stop()
+		log.Info("VPN interface detached")
+	}
+}
+
+// vpnRequest is one message on the VPN socket; "attach" carries the
+// interface's descriptor beside it.
+type vpnRequest struct {
+	Op    string   `json:"op"`
+	MTU   int      `json:"mtu"`
+	Addrs []string `json:"addrs"`
+}
+
+type vpnReply struct {
+	Error string `json:"error,omitempty"`
+}
+
+// ServeVPN listens on a unix socket at path for the app's VPN interface;
+// from then on every engine's device can share the NetBird address with it.
+// direct builds the path for what no peer carries.
+func ServeVPN(path string, direct DirectEgressFactory) error {
+	if direct == nil {
+		return errors.New("no direct path")
+	}
+	vpnDirect = direct
+	_ = os.Remove(path)
+	l, err := net.ListenUnix("unixpacket", &net.UnixAddr{Name: path, Net: "unixpacket"})
+	if err != nil {
+		return err
+	}
+	if err := os.Chmod(path, 0o600); err != nil {
+		_ = l.Close()
+		return err
+	}
+	vpnServing.Store(true)
+	go func() {
+		for {
+			c, err := l.AcceptUnix()
+			if err != nil {
+				log.Errorf("VPN socket: %v", err)
+				return
+			}
+			go handleVPNConn(c)
+		}
+	}()
+	return nil
+}
+
+func handleVPNConn(c *net.UnixConn) {
+	defer c.Close()
+	_ = c.SetDeadline(time.Now().Add(vpnConnWait))
+	buf := make([]byte, vpnRequestMax)
+	oob := make([]byte, syscall.CmsgSpace(4*4))
+	n, oobn, _, _, err := c.ReadMsgUnix(buf, oob)
+	if err != nil {
+		return
+	}
+	fds := receivedFDs(oob[:oobn])
+	reply := func(err error) {
+		var r vpnReply
+		if err != nil {
+			r.Error = err.Error()
+		}
+		b, _ := json.Marshal(r)
+		_, _ = c.Write(b)
+	}
+	if err := checkPeer(c); err != nil {
+		closeFDs(fds)
+		reply(err)
+		return
+	}
+	var req vpnRequest
+	if err := json.Unmarshal(buf[:n], &req); err != nil {
+		closeFDs(fds)
+		reply(fmt.Errorf("request: %w", err))
+		return
+	}
+	switch req.Op {
+	case "attach":
+		reply(attachRequest(req, fds))
+	case "detach":
+		closeFDs(fds)
+		detachVPN()
+		reply(nil)
+	default:
+		closeFDs(fds)
+		reply(fmt.Errorf("unknown op %q", req.Op))
+	}
+}
+
+func attachRequest(req vpnRequest, fds []int) error {
+	if len(fds) != 1 {
+		closeFDs(fds)
+		return fmt.Errorf("one descriptor expected, got %d", len(fds))
+	}
+	var addrs []netip.Addr
+	for _, s := range req.Addrs {
+		a, err := netip.ParseAddr(s)
+		if err != nil {
+			closeFDs(fds)
+			return fmt.Errorf("address %q: %w", s, err)
+		}
+		addrs = append(addrs, a.Unmap())
+	}
+	// Non-blocking, so the file is pollable and a Close ends a blocked Read.
+	if err := unix.SetNonblock(fds[0], true); err != nil {
+		closeFDs(fds)
+		return fmt.Errorf("descriptor: %w", err)
+	}
+	f := os.NewFile(uintptr(fds[0]), "vpn")
+	if err := attachVPN(f, req.MTU, addrs); err != nil {
+		_ = f.Close()
+		return err
+	}
+	return nil
+}
+
+// checkPeer: only this daemon's own UID (the app) or root (the root engine's helper) hands over a VPN.
+func checkPeer(c *net.UnixConn) error {
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var cred *unix.Ucred
+	var credErr error
+	if err := raw.Control(func(fd uintptr) {
+		cred, credErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return err
+	}
+	if credErr != nil {
+		return credErr
+	}
+	// Root too: the root engine's helper hands over the interface it made.
+	if int(cred.Uid) != os.Getuid() && cred.Uid != 0 {
+		return fmt.Errorf("uid %d may not attach a VPN", cred.Uid)
+	}
+	return nil
+}
+
+func receivedFDs(oob []byte) []int {
+	msgs, err := syscall.ParseSocketControlMessage(oob)
+	if err != nil {
+		return nil
+	}
+	var fds []int
+	for i := range msgs {
+		if got, err := syscall.ParseUnixRights(&msgs[i]); err == nil {
+			fds = append(fds, got...)
+		}
+	}
+	return fds
+}
+
+func closeFDs(fds []int) {
+	for _, fd := range fds {
+		_ = syscall.Close(fd)
+	}
+}
--- netbird_orig/client/iface/netstack/vpn_split.go
+++ netbird_src/client/iface/netstack/vpn_split.go
@@ -0,0 +1,400 @@
+//go:build linux
+
+package netstack
+
+// vpn_split.go — BirdSocks: the engine's device while the app's VPN is
+// attached (vpn.go). Two stacks share the device's NetBird address: the
+// netstack, where the SOCKS5 and DNS proxies make their connections, and
+// Android's own, behind the VPN interface, where the phone's apps live.
+// Packets from both go to WireGuard; a packet from WireGuard goes back to
+// the netstack when it answers one of the netstack's connections, and to
+// Android otherwise, so a peer reaches the phone's apps with its own
+// address.
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"os"
+	"sync"
+	"time"
+
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+const (
+	protoICMP   = 1
+	protoTCP    = 6
+	protoUDP    = 17
+	protoICMPv6 = 58
+
+	tcpFlagFIN = 0x01
+	tcpFlagSYN = 0x02
+	tcpFlagRST = 0x04
+	tcpFlagACK = 0x10
+
+	// How long a connection is remembered without traffic.
+	flowTTLTCP     = 2 * time.Hour
+	flowTTLTCPDone = time.Minute
+	flowTTLUDP     = 3 * time.Minute
+	flowSweepEvery = time.Minute
+
+	// splitQueue is how many packets from Android wait for WireGuard, and
+	// kernelQueueWait how long a packet waits for room before it is dropped.
+	splitQueue      = 256
+	kernelQueueWait = 50 * time.Millisecond
+)
+
+// pktInfo is what routing needs from an IP packet.
+type pktInfo struct {
+	src, dst         netip.Addr
+	proto            uint8
+	srcPort, dstPort uint16
+	// ports is false for a fragment past the first, or a header cut short.
+	ports    bool
+	tcpFlags uint8
+}
+
+// parsePacket reads an IPv4 or IPv6 header and the ports after it. IPv6
+// extension headers are not followed: such a packet has no ports.
+func parsePacket(p []byte) (pktInfo, bool) {
+	var pi pktInfo
+	if len(p) == 0 {
+		return pi, false
+	}
+	var l4 []byte
+	switch p[0] >> 4 {
+	case 4:
+		if len(p) < 20 {
+			return pi, false
+		}
+		ihl := int(p[0]&0x0f) * 4
+		if ihl < 20 || len(p) < ihl {
+			return pi, false
+		}
+		pi.src = netip.AddrFrom4([4]byte(p[12:16]))
+		pi.dst = netip.AddrFrom4([4]byte(p[16:20]))
+		pi.proto = p[9]
+		if binary.BigEndian.Uint16(p[6:8])&0x1fff != 0 {
+			return pi, true
+		}
+		l4 = p[ihl:]
+	case 6:
+		if len(p) < 40 {
+			return pi, false
+		}
+		pi.src = netip.AddrFrom16([16]byte(p[8:24]))
+		pi.dst = netip.AddrFrom16([16]byte(p[24:40]))
+		pi.proto = p[6]
+		l4 = p[40:]
+	default:
+		return pi, false
+	}
+	switch pi.proto {
+	case protoTCP:
+		if len(l4) >= 14 {
+			pi.srcPort = binary.BigEndian.Uint16(l4[0:2])
+			pi.dstPort = binary.BigEndian.Uint16(l4[2:4])
+			pi.tcpFlags = l4[13]
+			pi.ports = true
+		}
+	case protoUDP:
+		if len(l4) >= 8 {
+			pi.srcPort = binary.BigEndian.Uint16(l4[0:2])
+			pi.dstPort = binary.BigEndian.Uint16(l4[2:4])
+			pi.ports = true
+		}
+	}
+	return pi, true
+}
+
+// flowKey is a connection seen from this device: protocol, local port,
+// remote address and port.
+type flowKey struct {
+	proto  uint8
+	local  uint16
+	remote netip.AddrPort
+}
+
+func outboundKey(pi pktInfo) flowKey {
+	return flowKey{proto: pi.proto, local: pi.srcPort}.withRemote(pi.dst, pi.dstPort)
+}
+
+func inboundKey(pi pktInfo) flowKey {
+	return flowKey{proto: pi.proto, local: pi.dstPort}.withRemote(pi.src, pi.srcPort)
+}
+
+func (k flowKey) withRemote(ip netip.Addr, port uint16) flowKey {
+	k.remote = netip.AddrPortFrom(ip.Unmap(), port)
+	return k
+}
+
+// flowTable remembers connections until they go quiet.
+type flowTable struct {
+	mu    sync.Mutex
+	until map[flowKey]time.Time
+	swept time.Time
+}
+
+func (t *flowTable) touch(k flowKey, ttl time.Duration) {
+	now := time.Now()
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.until == nil {
+		t.until = make(map[flowKey]time.Time)
+	}
+	t.until[k] = now.Add(ttl)
+	t.sweepLocked(now)
+}
+
+// shorten lets a closing connection go sooner, never later.
+func (t *flowTable) shorten(k flowKey, ttl time.Duration) {
+	deadline := time.Now().Add(ttl)
+	t.mu.Lock()
+	if cur, ok := t.until[k]; ok && cur.After(deadline) {
+		t.until[k] = deadline
+	}
+	t.mu.Unlock()
+}
+
+func (t *flowTable) has(k flowKey) bool {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	until, ok := t.until[k]
+	if !ok {
+		return false
+	}
+	if time.Now().After(until) {
+		delete(t.until, k)
+		return false
+	}
+	return true
+}
+
+func (t *flowTable) remove(k flowKey) {
+	t.mu.Lock()
+	delete(t.until, k)
+	t.mu.Unlock()
+}
+
+func (t *flowTable) sweepLocked(now time.Time) {
+	if now.Sub(t.swept) < flowSweepEvery {
+		return
+	}
+	t.swept = now
+	for k, until := range t.until {
+		if now.After(until) {
+			delete(t.until, k)
+		}
+	}
+}
+
+// noteTCP keeps a TCP connection's entry as its flags say: gone on a
+// reset, short-lived once it closes, refreshed otherwise.
+func (t *flowTable) noteTCP(k flowKey, flags uint8) {
+	switch {
+	case flags&tcpFlagRST != 0:
+		t.remove(k)
+	case flags&tcpFlagFIN != 0:
+		t.shorten(k, flowTTLTCPDone)
+	default:
+		t.touch(k, flowTTLTCP)
+	}
+}
+
+// splitTUN is the engine's tun device with the VPN beside the netstack.
+// Without a VPN attached it passes everything to and from the netstack.
+type splitTUN struct {
+	ns    tun.Device
+	local []netip.Addr
+
+	in     chan []byte
+	done   chan struct{}
+	nsDead chan struct{}
+	nsErr  error
+	once   sync.Once
+
+	// nsFlows: connections the netstack opened. kernelUDP: UDP flows
+	// Android's apps opened, so that their answers count as answers.
+	nsFlows   flowTable
+	kernelUDP flowTable
+}
+
+func newSplitTUN(ns tun.Device, local []netip.Addr) *splitTUN {
+	s := &splitTUN{
+		ns:     ns,
+		local:  local,
+		in:     make(chan []byte, splitQueue),
+		done:   make(chan struct{}),
+		nsDead: make(chan struct{}),
+	}
+	go s.pumpNetstack()
+	return s
+}
+
+func (s *splitTUN) pumpNetstack() {
+	buf := make([]byte, 65535)
+	bufs, sizes := [][]byte{buf}, []int{0}
+	for {
+		n, err := s.ns.Read(bufs, sizes, 0)
+		if err != nil {
+			s.nsErr = err
+			close(s.nsDead)
+			return
+		}
+		for i := 0; i < n; i++ {
+			p := append([]byte(nil), bufs[i][:sizes[i]]...)
+			s.noteNetstack(p)
+			select {
+			case s.in <- p:
+			case <-s.done:
+				return
+			}
+		}
+	}
+}
+
+func (s *splitTUN) noteNetstack(p []byte) {
+	pi, ok := parsePacket(p)
+	if !ok || !pi.ports {
+		return
+	}
+	k := outboundKey(pi)
+	switch pi.proto {
+	case protoTCP:
+		s.nsFlows.noteTCP(k, pi.tcpFlags)
+	case protoUDP:
+		s.nsFlows.touch(k, flowTTLUDP)
+	}
+}
+
+// fromKernel queues a packet an app sent to a peer; false when it was
+// dropped.
+func (s *splitTUN) fromKernel(p []byte, pi pktInfo) bool {
+	if pi.ports {
+		k := outboundKey(pi)
+		// Android owns this connection now, whatever the netstack had.
+		s.nsFlows.remove(k)
+		if pi.proto == protoUDP {
+			s.kernelUDP.touch(k, flowTTLUDP)
+		}
+	}
+	select {
+	case s.in <- p:
+		return true
+	default:
+	}
+	t := time.NewTimer(kernelQueueWait)
+	defer t.Stop()
+	select {
+	case s.in <- p:
+		return true
+	case <-t.C:
+	case <-s.done:
+	case <-s.nsDead:
+	}
+	return false
+}
+
+func (s *splitTUN) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	select {
+	case p := <-s.in:
+		sizes[0] = copy(bufs[0][offset:], p)
+		return 1, nil
+	case <-s.nsDead:
+		return 0, s.nsErr
+	case <-s.done:
+		return 0, os.ErrClosed
+	}
+}
+
+func (s *splitTUN) Write(bufs [][]byte, offset int) (int, error) {
+	var toNS [][]byte
+	for _, b := range bufs {
+		if !s.toKernel(b[offset:]) {
+			toNS = append(toNS, b)
+		}
+	}
+	if len(toNS) > 0 {
+		if _, err := s.ns.Write(toNS, offset); err != nil {
+			return 0, err
+		}
+	}
+	return len(bufs), nil
+}
+
+// toKernel takes a packet from WireGuard that is Android's: written to the
+// VPN interface, or dropped when the device does not take new connections.
+// false leaves it to the netstack.
+func (s *splitTUN) toKernel(p []byte) bool {
+	k := attachedKernel()
+	if k == nil {
+		return false
+	}
+	pi, ok := parsePacket(p)
+	if !ok || !s.isLocal(pi.dst) {
+		return false
+	}
+	if pi.ports && (pi.proto == protoTCP || pi.proto == protoUDP) {
+		key := inboundKey(pi)
+		if s.nsFlows.has(key) {
+			if pi.proto == protoTCP {
+				s.nsFlows.noteTCP(key, pi.tcpFlags)
+			}
+			return false
+		}
+	}
+	if admitInbound(pi, &s.kernelUDP) {
+		k.write(p)
+	}
+	return true
+}
+
+func (s *splitTUN) isLocal(ip netip.Addr) bool {
+	for _, a := range s.local {
+		if a == ip {
+			return true
+		}
+	}
+	return false
+}
+
+// admitInbound decides a packet for Android that answers nothing the
+// netstack opened: answers to the apps' own connections pass, and a new
+// connection from a peer only when the device takes them (Access to the
+// phone), never to the app's own proxies. Pings pass, as the netstack
+// answers them without the VPN.
+func admitInbound(pi pktInfo, kernelUDP *flowTable) bool {
+	switch pi.proto {
+	case protoTCP:
+		if !pi.ports || pi.tcpFlags&(tcpFlagSYN|tcpFlagACK) != tcpFlagSYN {
+			return true
+		}
+		return inboundAllowed(pi.dstPort)
+	case protoUDP:
+		if !pi.ports {
+			return vpnInbound()
+		}
+		if kernelUDP.has(inboundKey(pi)) {
+			return true
+		}
+		return inboundAllowed(pi.dstPort)
+	case protoICMP, protoICMPv6:
+		return true
+	default:
+		return vpnInbound()
+	}
+}
+
+func (s *splitTUN) Close() error {
+	s.once.Do(func() {
+		close(s.done)
+		releaseSplit(s)
+	})
+	return s.ns.Close()
+}
+
+func (s *splitTUN) File() *os.File           { return nil }
+func (s *splitTUN) MTU() (int, error)        { return s.ns.MTU() }
+func (s *splitTUN) Name() (string, error)    { return s.ns.Name() }
+func (s *splitTUN) Events() <-chan tun.Event { return s.ns.Events() }
+func (s *splitTUN) BatchSize() int           { return 1 }
