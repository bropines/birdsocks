+//go:build linux
+
+package anet
+
+import (
+	"net"
+	"sort"
+	"testing"
+)
+
+// The Android path (NB_ANDROID_SDK ≥ 30) must find the same interfaces and
+// addresses as the standard library where both work.
+func TestAndroidPathMatchesStdlib(t *testing.T) {
+	t.Setenv("NB_ANDROID_SDK", "35")
+	if androidApiLevel() < android11ApiLevel {
+		t.Fatal("NB_ANDROID_SDK did not select the Android path")
+	}
+	want, err := net.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	names := func(ifs []net.Interface) []string {
+		var n []string
+		for _, i := range ifs {
+			n = append(n, i.Name)
+		}
+		sort.Strings(n)
+		return n
+	}
+	// RTM_GETADDR only knows interfaces with an address; the stdlib lists all.
+	have := map[string]net.Interface{}
+	for _, i := range got {
+		have[i.Name] = i
+	}
+	for _, w := range want {
+		addrs, _ := w.Addrs()
+		if len(addrs) == 0 {
+			continue
+		}
+		g, ok := have[w.Name]
+		if !ok {
+			t.Errorf("%s (with addresses) missing: got %v, stdlib %v", w.Name, names(got), names(want))
+			continue
+		}
+		if g.Index != w.Index || g.Flags != w.Flags || g.MTU != w.MTU {
+			t.Errorf("%s: got %+v, stdlib %+v", w.Name, g, w)
+		}
+		ga, err := InterfaceAddrsByInterface(&g)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(ga) != len(addrs) {
+			t.Errorf("%s: addresses %v, stdlib %v", w.Name, ga, addrs)
+		}
+	}
+}
