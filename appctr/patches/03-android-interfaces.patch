+//go:build linux
+
+package anet
+
+import (
+	"os"
+	"strconv"
+)
+
+// androidDeviceApiLevel is the Android API level the app reports in
+// NB_ANDROID_SDK, or -1 off Android: then every call is the standard
+// library's.
+func androidDeviceApiLevel() int {
+	if v, err := strconv.Atoi(os.Getenv("NB_ANDROID_SDK")); err == nil && v > 0 {
+		return v
+	}
+	return -1
+}
