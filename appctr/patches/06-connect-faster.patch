+package client
+
+import (
+	"context"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.zx2c4.com/wireguard/wgctrl/wgtypes"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/peer"
+
+	"github.com/netbirdio/netbird/shared/signal/proto"
+)
+
+// silentFirstServer never answers a stream on the first connection it sees,
+// and registers peers normally on any later one.
+type silentFirstServer struct {
+	proto.UnimplementedSignalExchangeServer
+	mu    sync.Mutex
+	first string
+	conns map[string]bool
+}
+
+func (s *silentFirstServer) ConnectStream(stream proto.SignalExchange_ConnectStreamServer) error {
+	p, _ := peer.FromContext(stream.Context())
+	addr := p.Addr.String()
+	s.mu.Lock()
+	if s.first == "" {
+		s.first = addr
+	}
+	s.conns[addr] = true
+	silent := addr == s.first
+	s.mu.Unlock()
+	if silent {
+		<-stream.Context().Done()
+		return nil
+	}
+	if err := stream.SendHeader(metadata.Pairs(proto.HeaderRegistered, "1")); err != nil {
+		return err
+	}
+	<-stream.Context().Done()
+	return nil
+}
+
+func TestUnansweredStreamRedials(t *testing.T) {
+	old := registrationTimeout
+	registrationTimeout = 500 * time.Millisecond
+	defer func() { registrationTimeout = old }()
+
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := grpc.NewServer()
+	fake := &silentFirstServer{conns: map[string]bool{}}
+	proto.RegisterSignalExchangeServer(srv, fake)
+	go srv.Serve(lis)
+	defer srv.Stop()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	key, _ := wgtypes.GeneratePrivateKey()
+	start := time.Now()
+	c, err := NewClient(ctx, lis.Addr().String(), key, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	received := make(chan struct{})
+	go func() {
+		defer close(received)
+		_ = c.Receive(ctx, func(*proto.Message) error { return nil })
+	}()
+	// Close only after Receive has returned: upstream's Close races a live Receive.
+	defer func() { cancel(); <-received; _ = c.Close() }()
+	c.WaitStreamConnected(ctx)
+	if ctx.Err() != nil {
+		t.Fatal("never registered")
+	}
+	took := time.Since(start)
+	fake.mu.Lock()
+	n := len(fake.conns)
+	fake.mu.Unlock()
+	if n < 2 {
+		t.Fatalf("registered over %d connection(s); the silent one should have been dropped", n)
+	}
+	if took > 5*time.Second {
+		t.Fatalf("registered after %v", took)
+	}
+	t.Logf("registered after %v over %d connections", took, n)
+}
