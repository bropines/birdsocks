+// WithDialHook dials as WithSweeper does (as WithCustomDialer when sweeper
+// is nil) and hands every new connection to hook, so its owner can drop a
+// transport that gRPC still believes healthy. Append it after the others.
+func WithDialHook(sweeper Sweeper, hook func(net.Conn)) grpc.DialOption {
+	return grpc.WithContextDialer(func(ctx context.Context, addr string) (net.Conn, error) {
+		var conn net.Conn
+		var err error
+		if sweeper == nil {
+			conn, err = dialContext(ctx, addr)
+		} else {
+			dial := sweeper.StartDial(ctx)
+			defer dial.Release()
+			if conn, err = dialContext(dial.Ctx(), addr); err == nil {
+				conn, err = dial.WrapConn(conn)
+			}
+		}
+		if err != nil {
+			return nil, err
+		}
+		hook(conn)
+		return conn, nil
+	})
+}
+
+// dialContext reaches a management or signal server, through the control
+// proxy when the app names one (BirdSocks, see client/net/birdsocks_ctlproxy.go).
 func dialContext(ctx context.Context, addr string) (net.Conn, error) {
+	return nbnet.DialControl(ctx, addr, func(ctx context.Context, _, addr string) (net.Conn, error) {
+		return dialDirect(ctx, addr)
+	})
+}
