+// dropTransport closes the connection gRPC dialed last, so the next stream
+// gets a new one instead of the transport that left this one unanswered.
+func (c *GrpcClient) dropTransport() {
+	if conn := c.transport.Load(); conn != nil {
+		log.Debugf("closing signal transport %s -> %s", (*conn).LocalAddr(), (*conn).RemoteAddr())
+		_ = (*conn).Close()
+	}
