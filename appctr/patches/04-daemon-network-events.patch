+
+// NotifyNetworkChange tells the client that the OS switched networks: the
+// management, signal and relay connections are marked stale and redial on
+// the new one, as NetBird's own mobile bindings do. BirdSocks: netstack mode
+// has no network monitor, so the app reports the change.
+func (s *Server) NotifyNetworkChange() {
+	s.netEvents.SetNetworkAvailable(true)
+	s.netEvents.NotifyNetworkChange()
+}
+
+// SetNetworkAvailable records whether the OS has any network: while it has
+// none, the reconnection loops wait instead of burning their backoff.
+func (s *Server) SetNetworkAvailable(available bool) {
+	s.netEvents.SetNetworkAvailable(available)
+}
